---
/**
 * /admin/filiacao — Pasta Diretoria de Filiação (#659, epic #660 step 2).
 * Function-anchored panel: visible/usable by the OFFICE of the Diretoria de Filiação
 * (designation `filiacao_director`) + manage_member/superadmin. Server RPCs are the real boundary.
 */
import AdminLayout from '../../layouts/AdminLayout.astro';
import AffiliationQueueIsland from '../../components/admin/AffiliationQueueIsland';
import Toast from '../../components/ui/Toast.astro';
import { t, getLangFromURL, type Lang } from '../../i18n/utils';
import { buildPageI18n } from '../../i18n/pageI18n';
const lang: Lang = getLangFromURL(Astro.url.pathname + Astro.url.search);
const i18nBundle = buildPageI18n(['comp.affiliationQueue', 'comp.common'], lang);
---

<AdminLayout
  title={t('admin.breadcrumb.affiliation', lang)}
  breadcrumbs={[
    { label: t('admin.breadcrumb.people', lang) },
    { label: t('admin.breadcrumb.affiliation', lang) },
  ]}
>
  <script id="page-i18n" type="application/json" set:html={i18nBundle}></script>
  <div class="max-w-[1200px] mx-auto px-4 pb-12">
    <AffiliationQueueIsland client:load />
  </div>
  <Toast />
  <span id="filiacao-denied-text" class="hidden">{t('admin.deniedAdmin', lang)}</span>
</AdminLayout>

<script>
  // UX gate only: the server RPCs are the real boundary (filiacao_director OR manage_member).
  // #2974 (F1): decide quando o Nav resolve o membro e as capacidades, pela mesma entrada que decide o link no
  // menu e na sidebar (ADMIN_ROUTE_ACCESS), que é a pergunta das RPCs da fila.
  import { canEnterAdminRoute } from '../../lib/navigation.config';
  import { adminLoadFailedText, adminSignInText, gateAdminPage } from '../../lib/member-ready';

  function showFiliacaoNotice(text: string) {
    const box = document.querySelector('.max-w-\\[1200px\\]');
    if (!box) return;
    const div = document.createElement('div');
    div.className = 'text-center py-20 text-[var(--text-muted)]';
    div.textContent = text;
    box.replaceChildren(div);
  }

  gateAdminPage({
    allow: (m) => canEnterAdminRoute('/admin/filiacao', m),
    onAllowed: () => {},
    onDenied: () => showFiliacaoNotice(document.getElementById('filiacao-denied-text')?.textContent?.trim() || ''),
    onNoSession: () => showFiliacaoNotice(adminSignInText()),
    onLoadFailed: () => showFiliacaoNotice(adminLoadFailedText()),
  });
</script>
