---
import AdminLayout from '../../layouts/AdminLayout.astro';
import VepReconciliationIsland from '../../components/admin/VepReconciliationIsland';
import Toast from '../../components/ui/Toast.astro';
import { t, getLangFromURL, type Lang } from '../../i18n/utils';
import { buildPageI18n } from '../../i18n/pageI18n';
const lang: Lang = getLangFromURL(Astro.url.pathname + Astro.url.search);
// #1133 — inject the VEP reconciliation island strings (migrated from local L object).
const i18nBundle = buildPageI18n(['comp.vepReconciliation'], lang);
---

<AdminLayout
  title={t('admin.breadcrumb.vepReconciliation', lang)}
  breadcrumbs={[
    { label: t('admin.breadcrumb.system', lang) },
    { label: t('admin.breadcrumb.vepReconciliation', lang) },
  ]}
>
  <script id="page-i18n" type="application/json" set:html={i18nBundle}></script>
  <div id="vep-reconciliation-notice" class="hidden max-w-[1100px] mx-auto px-4 text-center py-20 text-[var(--text-muted)]">{t('admin.deniedAdmin', lang)}</div>
  <div id="vep-reconciliation-content" class="max-w-[1100px] mx-auto px-4 pb-12">
    <VepReconciliationIsland client:load lang={lang} />
  </div>
  <Toast />
</AdminLayout>

<script>
  import { adminLoadFailedText, adminSignInText, gateAdminPage } from '../../lib/member-ready';

  // ADR-0083 Tier B
  function hasVepReconciliationAccess(member: any): boolean {
    const hasAdminCapability = (window as any).__nucleoCanForAdminEntry?.() === true;
    const v3HardTier = ['manager', 'deputy_manager'].includes(member.operational_role);
    const hasAdminDesignation = (member.designations || []).some(function(d: string) { return d === 'deputy_manager' || d === 'curator'; });
    return member.is_superadmin || hasAdminCapability || v3HardTier || hasAdminDesignation;
  }

  const VEP_RECONCILIATION_DENIED_TEXT = document.getElementById('vep-reconciliation-notice')?.textContent?.trim() || '';

  function showVepReconciliationNotice(text: string) {
    const notice = document.getElementById('vep-reconciliation-notice');
    if (notice) { notice.textContent = text; notice.classList.remove('hidden'); }
    document.getElementById('vep-reconciliation-content')?.classList.add('hidden');
  }

  function showVepReconciliationPage() {
    document.getElementById('vep-reconciliation-notice')?.classList.add('hidden');
    document.getElementById('vep-reconciliation-content')?.classList.remove('hidden');
  }

  // #2974 (F2): a espera é a do gateAdminPage, que decide quando o Nav resolve o membro, sem prazo. Sem sessão, a
  // tela pede para entrar. O predicado do allow é o de antes.
  gateAdminPage({
    allow: hasVepReconciliationAccess,
    onAllowed: () => showVepReconciliationPage(),
    onDenied: () => showVepReconciliationNotice(VEP_RECONCILIATION_DENIED_TEXT),
    onNoSession: () => showVepReconciliationNotice(adminSignInText()),
    onLoadFailed: () => showVepReconciliationNotice(adminLoadFailedText()),
  });
</script>
