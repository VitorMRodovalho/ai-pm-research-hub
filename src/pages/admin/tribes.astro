---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { t, getLangFromURL, type Lang, getPrefix } from '../../i18n/utils';
import { buildPageI18n } from '../../i18n/pageI18n';
import CrossTribeIsland from '../../components/islands/CrossTribeIsland';

const lang: Lang = getLangFromURL(Astro.url.pathname + Astro.url.search);
const langPrefix = getPrefix(lang);
const i18nBundle = buildPageI18n(['comp.cross', 'comp.crossTribe', 'comp.tribe', 'comp.common'], lang);
---

<AdminLayout title={t('admin.breadcrumb.tribesComparison', lang)} breadcrumbs={[{label: t('admin.breadcrumb.people', lang)},{label: t('admin.breadcrumb.tribes', lang)}]}>

  <div id="tribes-notice" class="hidden max-w-[1200px] mx-auto px-4 text-center py-20 text-[var(--text-muted)]">{t('admin.tribes.denied', lang)}</div>
  <div id="tribes-content" class="max-w-[1200px] mx-auto px-4 pb-12">
    <div class="mb-6">
      <h1 class="text-xl font-bold text-[var(--text-primary)]">{t('admin.breadcrumb.tribesComparison', lang)} — Ciclo 4</h1>
      <p class="text-sm text-[var(--text-secondary)] mt-1">{t('admin.tribes.subtitle', lang)}</p>
      <p class="text-[12px] text-[var(--text-muted)] mt-2">{t('admin.tribes.crudHint', lang)}</p>
      <div class="mt-3 flex items-center gap-2 flex-wrap bg-blue-50 border border-blue-200 rounded-lg px-3 py-2">
        <span class="text-[12px] text-blue-800">{t('admin.tribes.otherInitiativesNote', lang)}</span>
        <a href={`${langPrefix}/admin/portfolio`} class="text-[12px] font-semibold text-blue-700 hover:underline no-underline ml-auto">{t('admin.tribes.otherInitiativesLink', lang)}</a>
      </div>
    </div>
    <script id="page-i18n" type="application/json" set:html={i18nBundle}></script>
    <CrossTribeIsland client:load />
  </div>
</AdminLayout>

<script>
  import { adminLoadFailedText, adminSignInText, gateAdminPage } from '../../lib/member-ready';

  // ADR-0007 V4 (p163 Opção C): see docs/audit/P163_A3_BACKFILL_DECISION_AUDIT.md
  function hasTribesAccess(member: any): boolean {
    const hasAdminCapability = (window as any).__nucleoCanForAdminEntry?.() === true;
    const v3HardTier = ['manager', 'deputy_manager'].includes(member.operational_role);
    const hasAdminDesignation = (member.designations || []).some(function(d: string) { return d === 'deputy_manager' || d === 'curator'; });
    return member.is_superadmin || hasAdminCapability || v3HardTier || hasAdminDesignation;
  }

  const TRIBES_DENIED_TEXT = document.getElementById('tribes-notice')?.textContent?.trim() || '';

  function showTribesNotice(text: string) {
    const notice = document.getElementById('tribes-notice');
    if (notice) { notice.textContent = text; notice.classList.remove('hidden'); }
    document.getElementById('tribes-content')?.classList.add('hidden');
  }

  function showTribesPage() {
    document.getElementById('tribes-notice')?.classList.add('hidden');
    document.getElementById('tribes-content')?.classList.remove('hidden');
  }

  // #2974 (F6): o portão antigo esperava window.navMember, que nada define, e por isso nunca decidia. A espera agora
  // é a do gateAdminPage, que decide quando o Nav resolve o membro, sem prazo. Sem sessão, a tela pede para entrar.
  // O predicado do allow é o que a página já tinha.
  gateAdminPage({
    allow: hasTribesAccess,
    onAllowed: () => showTribesPage(),
    onDenied: () => showTribesNotice(TRIBES_DENIED_TEXT),
    onNoSession: () => showTribesNotice(adminSignInText()),
    onLoadFailed: () => showTribesNotice(adminLoadFailedText()),
  });
</script>
