---
import AdminLayout from '../../layouts/AdminLayout.astro';
import TagManagementIsland from '../../components/admin/TagManagementIsland';
import Toast from '../../components/ui/Toast.astro';
import { t, getLangFromURL, type Lang } from '../../i18n/utils';
import { buildPageI18n } from '../../i18n/pageI18n';
const lang: Lang = getLangFromURL(Astro.url.pathname + Astro.url.search);
const i18nBundle = buildPageI18n(['comp.tagMgmt', 'comp.common'], lang);
---

<AdminLayout title={t('admin.breadcrumb.tags', lang)} breadcrumbs={[{label: t('admin.breadcrumb.system', lang)},{label: t('admin.breadcrumb.tags', lang)}]}>
  <script id="page-i18n" type="application/json" set:html={i18nBundle}></script>
  <div id="tags-notice" class="hidden max-w-[1100px] mx-auto px-4 text-center py-20 text-[var(--text-muted)]">{t('admin.deniedAdmin', lang)}</div>
  <div id="tags-content" class="max-w-[1100px] mx-auto px-4 pb-12">
    <TagManagementIsland client:load />
  </div>
  <Toast />
</AdminLayout>

<script>
  import { adminLoadFailedText, adminSignInText, gateAdminPage } from '../../lib/member-ready';

  // ADR-0083 Tier B
  function hasTagsAccess(member: any): boolean {
    const hasAdminCapability = (window as any).__nucleoCanForAdminEntry?.() === true;
    const v3HardTier = ['manager', 'deputy_manager'].includes(member.operational_role);
    const hasAdminDesignation = (member.designations || []).some(function(d: string) { return d === 'deputy_manager' || d === 'curator'; });
    return member.is_superadmin || hasAdminCapability || v3HardTier || hasAdminDesignation;
  }

  const TAGS_DENIED_TEXT = document.getElementById('tags-notice')?.textContent?.trim() || '';

  function showTagsNotice(text: string) {
    const notice = document.getElementById('tags-notice');
    if (notice) { notice.textContent = text; notice.classList.remove('hidden'); }
    document.getElementById('tags-content')?.classList.add('hidden');
  }

  function showTagsPage() {
    document.getElementById('tags-notice')?.classList.add('hidden');
    document.getElementById('tags-content')?.classList.remove('hidden');
  }

  // #2974 (F2): a espera é a do gateAdminPage, que decide quando o Nav resolve o membro, sem prazo. Sem sessão, a
  // tela pede para entrar. O predicado do allow é o de antes.
  gateAdminPage({
    allow: hasTagsAccess,
    onAllowed: () => showTagsPage(),
    onDenied: () => showTagsNotice(TAGS_DENIED_TEXT),
    onNoSession: () => showTagsNotice(adminSignInText()),
    onLoadFailed: () => showTagsNotice(adminLoadFailedText()),
  });
</script>
