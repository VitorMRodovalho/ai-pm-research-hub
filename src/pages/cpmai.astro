---
import BaseLayout from '../layouts/BaseLayout.astro';
import CpmaiLanding from '../components/cpmai/CpmaiLanding';
import { t, getLangFromURL, type Lang } from '../i18n/utils';
import { buildPageI18n } from '../i18n/pageI18n';
const lang: Lang = getLangFromURL(Astro.url.pathname + Astro.url.search);
const langPrefix = lang === 'pt-BR' ? '' : lang === 'en-US' ? '/en' : '/es';
const i18nBundle = buildPageI18n(['cpmai'], lang);
---
<BaseLayout title={t('cpmai.title', lang)} activePage="cpmai" lang={lang}>
  <meta slot="head" name="robots" content="noindex" />
  <script is:inline define:vars={{ langPrefix }}>window.__LANG_PREFIX = langPrefix;</script>
  <script id="page-i18n" type="application/json" set:html={i18nBundle}></script>
  <main class="max-w-6xl mx-auto px-4 py-8">
    <CpmaiLanding client:load />
  </main>
</BaseLayout>
