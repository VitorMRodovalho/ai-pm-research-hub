---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PMIOnboardingPortal from '../../components/pmi-onboarding/PMIOnboardingPortal';
import { t, getLangFromURL, type Lang } from '../../i18n/utils';
import { buildPageI18n } from '../../i18n/pageI18n';
import { createClient } from '@supabase/supabase-js';

export const prerender = false;

const lang: Lang = getLangFromURL(Astro.url.pathname + Astro.url.search);
const i18n = JSON.parse(buildPageI18n(['pmi.onboarding', 'meStatus.statusBadge'], lang));

const { token } = Astro.params;

let initialPayload: any = null;
let errorMessage: string | null = null;
// #3106: falha de banco ou de rede não é link expirado. Quem lê 'link expirado' conclui que perdeu o link.
let loadFailed = false;

if (!token || token.length < 16) {
  errorMessage = 'invalid_token_format';
} else {
  const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
  const supabaseAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
  const sb = createClient(supabaseUrl, supabaseAnonKey);

  try {
    const { data, error } = await sb.rpc('consume_onboarding_token', { p_token: token });
    if (error) {
      errorMessage = error.message?.includes('Invalid or expired')
        ? 'invalid_or_expired'
        : 'rpc_error';
      if (errorMessage === 'rpc_error') { loadFailed = true; console.error('consume_onboarding_token failed:', error.message); }
    } else {
      initialPayload = data;
    }
  } catch (e: any) {
    errorMessage = 'network_error';
    loadFailed = true;
    console.error('consume_onboarding_token network failure:', e?.message ?? 'unknown');
  }
}

const pageTitle = t('pmi.onboarding.meta.title', lang);
const pageDesc = t('pmi.onboarding.meta.description', lang);
---

<BaseLayout title={pageTitle} description={pageDesc} lang={lang}>
  <main class="max-w-4xl mx-auto px-4 py-8 md:py-12">
    {errorMessage && loadFailed ? (
      <div id="token-load-failed" class="bg-amber-50 border border-amber-200 rounded-lg p-6 text-amber-900">
        <h1 class="text-2xl font-bold mb-3">{t('tokenLink.loadFailedTitle', lang)}</h1>
        <p class="mb-4">{t('tokenLink.loadFailedBody', lang)}</p>
        <a href={Astro.url.pathname + Astro.url.search} class="inline-block px-5 py-2.5 bg-navy text-white rounded-xl font-semibold text-sm no-underline hover:opacity-90">{t('tokenLink.retry', lang)}</a>
        <p class="text-sm font-mono text-amber-800 mt-4">code: {errorMessage}</p>
        <p class="mt-4">
          <a href="mailto:nucleoia@pmigo.org.br" class="underline">nucleoia@pmigo.org.br</a>
        </p>
      </div>
    ) : errorMessage ? (
      <div class="bg-red-50 border border-red-200 rounded-lg p-6 text-red-800">
        <h1 class="text-2xl font-bold mb-3">{t('pmi.onboarding.error.expiredTitle', lang)}</h1>
        <p class="mb-4">{t('pmi.onboarding.error.expiredBody', lang)}</p>
        <p class="text-sm font-mono text-red-700">code: {errorMessage}</p>
        <p class="mt-4">
          <a href="mailto:nucleoia@pmigo.org.br" class="underline">nucleoia@pmigo.org.br</a>
        </p>
      </div>
    ) : (
      <PMIOnboardingPortal
        client:load
        token={token}
        initialPayload={initialPayload}
        i18n={i18n}
        lang={lang}
        supabaseUrl={import.meta.env.PUBLIC_SUPABASE_URL}
        supabaseAnonKey={import.meta.env.PUBLIC_SUPABASE_ANON_KEY}
      />
    )}
  </main>
</BaseLayout>
