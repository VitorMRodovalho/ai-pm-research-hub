---
/**
 * /wiki — o wiki vivo do Núcleo (#2495, ADR-0129 com as emendas 1 e 2).
 *
 * Uma tela só; a visão vem da URL, para que o aviso e o e-mail levem direto ao ponto:
 *   (padrão)              início: busca com sugestão, atalhos por objetivo, "Comece aqui", tribos, recentes
 *   ?q= | ?type=          resultados da busca, filtráveis pelo tipo Diátaxis (tag diataxis-<tipo>)
 *   ?page=<caminho>       leitura em 3 colunas: páginas, artigo (fonte, tribo dona, auditoria), "Nesta página"
 *   ?version=<id>         uma versão e as ações de quem pode agir sobre ela (os avisos apontam aqui)
 *   ?edit=<id> | ?new=<tribo>[&path=] | ?alter=<id>   editor (rascunho do autor, versão nova, alteração do comitê)
 *   ?tab=mine|decide|audit                            minhas versões, fila da liderança, fila do comitê
 *
 * Sem portão SSR por desenho (ADR-0106): o limite é a RLS de wiki_pages (membro ativo) e as RPCs
 * SECURITY DEFINER do piloto, que decidem quem escreve, publica e audita. A tela só oferece a ação
 * que o servidor aceitaria para aquela pessoa, e o servidor recusa se a tela errar.
 *
 * Fase A da descoberta (27/09, GP aprovou o protótipo): a jornada principal é ENCONTRAR, não cadastrar.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Toast from '../components/ui/Toast.astro';
import { t, getLangFromURL, type Lang } from '../i18n/utils';
import { buildPageI18n } from '../i18n/pageI18n';

const lang: Lang = getLangFromURL(Astro.url.pathname + Astro.url.search);
const i18nBundle = buildPageI18n(['wiki'], lang);
const langPrefix = lang === 'pt-BR' ? '' : lang === 'en-US' ? '/en' : '/es';
---

<BaseLayout title={t('wiki.title', lang)} activePage="wiki" lang={lang}>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,400;8..60,600;8..60,700&display=swap" />
  <div id="wiki-root" data-lang={lang} class="wk-shell">
    <div id="wiki-loading" class="text-center py-16 text-[var(--text-muted)]">{t('wiki.loading', lang)}</div>

    <section id="wiki-gate" class="hidden wk-gate">
      <picture>
        <source srcset="/assets/nia/nia-acenando.webp" type="image/webp" />
        <img src="/assets/nia/nia-acenando.png" alt={t('wiki.niaAlt', lang)} width="110" height="181" />
      </picture>
      <h1 class="wk-serif">{t('wiki.gateTitle', lang)}</h1>
      <p>{t('wiki.gateBody', lang)}</p>
      <p id="wiki-gate-msg" class="font-semibold"></p>
      <div class="wk-row">
        <button type="button" id="wiki-gate-login" class="wk-btn wk-btn-primary hidden">{t('wiki.gateLogin', lang)}</button>
        <a href={`${langPrefix}/#join`} class="wk-btn wk-btn-ghost">{t('wiki.gateJoin', lang)}</a>
      </div>
    </section>

    <div id="wiki-app" class="hidden">
      <div id="wiki-bar" class="wk-bar hidden">
        <a id="wiki-home" href={`${langPrefix}/wiki`} class="wk-wordmark wk-serif">{t('wiki.title', lang)}</a>
        <div class="wk-mini" data-search="mini"></div>
        <nav id="wiki-tabs" class="wk-work" aria-label={t('wiki.workNav', lang)}></nav>
      </div>
      <section id="wiki-view" aria-live="polite"></section>
    </div>
  </div>
  <Toast />
  <script id="page-i18n" type="application/json" set:html={i18nBundle}></script>
</BaseLayout>

<style is:global>
  .wk-shell { max-width: 1180px; margin: 0 auto; padding: 1.5rem 1rem 3rem; }
  .wk-serif { font-family: 'Source Serif 4', Georgia, 'Times New Roman', serif; }
  .wk-btn { display: inline-flex; align-items: center; gap: .4rem; border-radius: .6rem; padding: .5rem .9rem; font-weight: 700; font-size: .85rem; cursor: pointer; border: 1px solid transparent; text-decoration: none; }
  .wk-btn:hover { text-decoration: none; opacity: .92; }
  .wk-btn-primary { background: var(--color-navy); color: #fff; }
  .wk-btn-ghost { background: var(--surface-card); border-color: var(--border-strong); color: var(--text-primary); }
  .wk-row { display: flex; flex-wrap: wrap; gap: .6rem; justify-content: center; margin-top: 1rem; }
  .wk-chip { display: inline-flex; align-items: center; gap: .25rem; font-size: .7rem; font-weight: 700; border-radius: 999px; padding: .1rem .55rem; white-space: nowrap; }
  .wk-chip-type { background: var(--color-teal-light); color: var(--color-teal-deep); }
  .wk-chip-old { background: #FFF4E0; color: #8A4B06; }
  .wk-chip-ok { background: #E7F6EF; color: #0F6B47; }
  .wk-chip-muted { background: var(--surface-section-cool); color: var(--text-secondary); }
  .wk-gate { max-width: 640px; margin: 2rem auto; text-align: center; background: var(--surface-card); border: 1px solid var(--border-default); border-radius: 1.1rem; padding: 2rem 1.4rem; }
  .wk-gate picture img { margin: 0 auto; height: auto; }
  .wk-gate h1 { font-size: 1.9rem; font-weight: 700; margin: .6rem 0 .5rem; color: var(--text-primary); }
  .wk-gate p { color: var(--text-secondary); margin: .3rem 0; }
  /* barra das telas internas */
  .wk-bar { display: flex; flex-wrap: wrap; align-items: center; gap: .8rem 1rem; padding-bottom: 1rem; margin-bottom: 1.25rem; border-bottom: 1px solid var(--border-default); }
  .wk-wordmark { font-size: 1.25rem; font-weight: 700; color: var(--text-primary); text-decoration: none; white-space: nowrap; }
  .wk-wordmark:hover { text-decoration: none; }
  .wk-mini { flex: 1; min-width: 220px; max-width: 460px; }
  .wk-work { display: flex; flex-wrap: wrap; gap: .4rem; margin-left: auto; }
  .wk-work a { font-size: .78rem; font-weight: 700; color: var(--text-secondary); border: 1px solid var(--border-strong); border-radius: .5rem; padding: .3rem .65rem; background: var(--surface-card); text-decoration: none; }
  .wk-work a[aria-current="page"] { background: var(--color-navy); color: #fff; border-color: var(--color-navy); }
  .wk-count { display: inline-block; min-width: 1.1rem; padding: 0 .3rem; margin-left: .3rem; border-radius: 999px; background: var(--color-orange); color: #fff; font-size: .68rem; text-align: center; }
  /* busca com sugestão */
  .wk-search { position: relative; }
  .wk-search input { width: 100%; border: 1px solid var(--border-strong); background: var(--surface-card); color: var(--text-primary); border-radius: .85rem; padding: .85rem 2.6rem .85rem 2.6rem; font-size: 1rem; box-shadow: 0 1px 2px rgba(10,22,40,.05), 0 8px 24px rgba(10,22,40,.05); }
  .wk-search input:focus { outline: none; border-color: var(--color-orange); box-shadow: 0 0 0 4px rgba(255,97,15,.16); }
  .wk-mini .wk-search input { padding: .5rem .8rem .5rem 2.2rem; font-size: .88rem; border-radius: .6rem; box-shadow: none; }
  .wk-search .wk-ico { position: absolute; left: .9rem; top: 50%; transform: translateY(-50%); color: var(--text-muted); pointer-events: none; }
  .wk-mini .wk-search .wk-ico { left: .7rem; }
  .wk-search kbd { position: absolute; right: .8rem; top: 50%; transform: translateY(-50%); font-size: .7rem; color: var(--text-muted); border: 1px solid var(--border-strong); border-radius: .3rem; padding: 0 .35rem; }
  .wk-mini .wk-search kbd { display: none; }
  .wk-sugg { position: absolute; left: 0; right: 0; top: calc(100% + .4rem); z-index: 40; background: var(--surface-elevated); border: 1px solid var(--border-strong); border-radius: .75rem; box-shadow: 0 12px 32px rgba(10,22,40,.14); padding: .35rem; max-height: 22rem; overflow: auto; text-align: left; }
  .wk-sugg a { display: block; border-radius: .5rem; padding: .5rem .65rem; color: var(--text-primary); text-decoration: none; }
  .wk-sugg a[aria-selected="true"], .wk-sugg a:hover { background: var(--surface-section-cool); text-decoration: none; }
  .wk-sugg .t { font-weight: 600; font-size: .9rem; }
  .wk-sugg .t mark { background: transparent; color: var(--color-orange-deep); font-weight: 800; }
  .wk-sugg .s { font-size: .74rem; color: var(--text-muted); }
  .wk-sugg .all { text-align: center; color: var(--color-teal-deep); font-weight: 700; font-size: .8rem; }
  /* início */
  .wk-hero { text-align: center; padding: 2.5rem 0 1.5rem; }
  .wk-hero h1 { font-size: clamp(2.1rem, 5vw, 3.1rem); font-weight: 700; color: var(--text-primary); letter-spacing: -.01em; text-wrap: balance; }
  .wk-hero .sub { color: var(--text-secondary); margin: .5rem auto 1.6rem; max-width: 36rem; font-size: 1rem; }
  .wk-hero .wk-search { max-width: 40rem; margin: 0 auto; }
  .wk-stats { margin-top: .9rem; font-size: .8rem; color: var(--text-muted); font-variant-numeric: tabular-nums; }
  .wk-callout { max-width: 48rem; margin: 0 auto 1.4rem; display: flex; align-items: center; gap: .8rem; flex-wrap: wrap; background: var(--color-orange-light); border: 1px solid rgba(255,97,15,.3); border-radius: .85rem; padding: .8rem 1rem; color: var(--text-primary); font-size: .88rem; }
  .wk-callout p { margin: 0; flex: 1; min-width: 14rem; }
  .wk-h2 { font-size: .78rem; letter-spacing: .08em; text-transform: uppercase; color: var(--text-secondary); font-weight: 800; margin: 0 0 .7rem; }
  .wk-goals { display: grid; grid-template-columns: repeat(4, 1fr); gap: .75rem; margin-bottom: 2rem; }
  .wk-goal { display: flex; flex-direction: column; gap: .3rem; background: var(--surface-card); border: 1px solid var(--border-default); border-radius: .85rem; padding: 1rem; color: var(--text-primary); text-decoration: none; }
  .wk-goal:hover { border-color: var(--border-strong); text-decoration: none; box-shadow: 0 8px 24px rgba(10,22,40,.06); }
  .wk-goal .verb { font-size: 1.1rem; font-weight: 800; }
  .wk-goal .what { font-size: .8rem; color: var(--text-secondary); }
  .wk-goal .n { margin-top: auto; font-size: .74rem; color: var(--text-muted); font-variant-numeric: tabular-nums; }
  .wk-grid2 { display: grid; grid-template-columns: 1.1fr 1fr; gap: 1rem; margin-bottom: 2rem; }
  .wk-panel { background: var(--surface-card); border: 1px solid var(--border-default); border-radius: 1rem; padding: 1.1rem; }
  .wk-start { display: grid; grid-template-columns: auto 1fr; gap: 1rem; align-items: center; }
  .wk-start img { width: 100px; height: auto; }
  .wk-start h3 { font-size: 1.1rem; font-weight: 800; margin: 0 0 .3rem; color: var(--text-primary); }
  .wk-start ol { margin: .4rem 0 .8rem; padding-left: 1.1rem; color: var(--text-secondary); font-size: .84rem; list-style: decimal; }
  /* O vídeo abre no YouTube: embutir o player exigiria abrir frame-src na CSP, que é item de revisão de segurança. */
  .wk-video { display: flex; flex-direction: column; gap: .5rem; border: 1px solid var(--border-default); border-radius: .6rem; padding: .6rem; font-size: .8rem; color: var(--text-secondary); text-decoration: none; }
  .wk-video:hover { border-color: var(--border-strong); }
  .wk-video .thumb { position: relative; display: block; }
  .wk-video .thumb img { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; border-radius: .45rem; }
  .wk-video .play { position: absolute; inset: 0; margin: auto; width: 2.6rem; height: 2.6rem; border-radius: 50%; background: var(--color-navy); color: #fff; display: grid; place-items: center; font-size: .9rem; }
  .wk-list { list-style: none; margin: 0; padding: 0; }
  .wk-list li { display: flex; justify-content: space-between; align-items: baseline; gap: .7rem; padding: .55rem 0; border-bottom: 1px solid var(--border-subtle); }
  .wk-list li:last-child { border-bottom: 0; }
  .wk-list a { color: var(--text-primary); font-weight: 600; font-size: .88rem; text-decoration: none; }
  .wk-list a:hover { color: var(--color-teal-deep); text-decoration: underline; }
  .wk-list .sm { font-size: .74rem; color: var(--text-muted); }
  .wk-list .when { font-size: .74rem; color: var(--text-muted); white-space: nowrap; font-variant-numeric: tabular-nums; }
  /* resultados */
  .wk-results { max-width: 50rem; margin: 0 auto; }
  .wk-results h1 { font-size: 1.7rem; font-weight: 700; color: var(--text-primary); }
  .wk-filters { display: flex; flex-wrap: wrap; gap: .35rem; margin: .7rem 0 1rem; }
  .wk-filters a { border: 1px solid var(--border-strong); background: var(--surface-card); border-radius: 999px; padding: .2rem .7rem; font-size: .78rem; color: var(--text-secondary); text-decoration: none; }
  .wk-filters a[aria-current="true"] { background: var(--color-navy); color: #fff; border-color: var(--color-navy); }
  .wk-hit { padding: .9rem 0; border-bottom: 1px solid var(--border-subtle); }
  .wk-hit .crumb { font-size: .72rem; color: var(--text-muted); }
  .wk-hit a.h { font-size: 1.05rem; font-weight: 700; color: var(--text-primary); text-decoration: none; }
  .wk-hit a.h:hover { text-decoration: underline; }
  .wk-hit p { margin: .2rem 0 .4rem; color: var(--text-secondary); font-size: .88rem; }
  .wk-hit mark { background: rgba(255,97,15,.2); color: inherit; border-radius: .2rem; padding: 0 .1rem; }
  /* artigo em 3 colunas */
  .wk-doc { display: grid; grid-template-columns: 14rem minmax(0, 1fr) 13rem; gap: 2rem; }
  .wk-side, .wk-toc { position: sticky; top: 5rem; align-self: start; max-height: calc(100vh - 6rem); overflow: auto; font-size: .84rem; }
  .wk-side h4, .wk-toc h4 { font-size: .68rem; letter-spacing: .09em; text-transform: uppercase; color: var(--text-muted); font-weight: 800; margin: 1rem 0 .35rem; }
  .wk-side h4:first-child, .wk-toc h4:first-child { margin-top: 0; }
  .wk-side a { display: flex; justify-content: space-between; gap: .4rem; padding: .25rem .5rem; border-radius: .4rem; color: var(--text-secondary); text-decoration: none; }
  .wk-side a:hover { background: var(--surface-card); color: var(--text-primary); }
  .wk-side a[aria-current="page"] { background: var(--surface-card); color: var(--text-primary); font-weight: 700; box-shadow: inset 2px 0 0 var(--color-orange); }
  .wk-toc a { display: block; padding: .2rem 0 .2rem .6rem; border-left: 2px solid var(--border-default); color: var(--text-muted); text-decoration: none; }
  .wk-toc a.sub { padding-left: 1.2rem; }
  .wk-toc a.on { color: var(--text-primary); font-weight: 700; border-left-color: var(--color-orange); }
  .wk-toc button { display: block; margin-top: 1rem; border: 0; background: transparent; padding: 0; color: var(--text-secondary); font-size: .82rem; cursor: pointer; text-align: left; }
  .wk-toc button:hover { color: var(--text-primary); }
  .wk-crumbs { font-size: .78rem; color: var(--text-muted); }
  .wk-crumbs a { color: var(--text-muted); }
  .wk-article h1 { font-size: clamp(1.8rem, 4vw, 2.4rem); line-height: 1.15; font-weight: 700; color: var(--text-primary); margin: .4rem 0 .6rem; text-wrap: balance; }
  .wk-meta { display: flex; flex-wrap: wrap; align-items: center; gap: .35rem .6rem; font-size: .76rem; color: var(--text-secondary); margin-bottom: .8rem; }
  .wk-seal { display: flex; gap: .6rem; align-items: flex-start; border: 1px solid var(--border-default); background: var(--surface-card); border-radius: .7rem; padding: .6rem .8rem; font-size: .8rem; color: var(--text-secondary); margin-bottom: .9rem; }
  .wk-actions { display: flex; flex-wrap: wrap; gap: .5rem; margin-bottom: 1.1rem; }
  .wk-lead { font-size: 1.15rem; line-height: 1.55; color: var(--text-primary); margin: 0 0 .5rem; }
  /* O texto fica em 70 caracteres por linha; a tabela usa a largura toda do artigo (#2495, 29/09: a de 6 colunas do
     guia de onboarding rolava de lado dentro dos 70 caracteres). */
  .wk-prose { font-family: 'Source Serif 4', Georgia, 'Times New Roman', serif; font-size: 1.06rem; line-height: 1.7; max-width: none; }
  .wk-prose > :not(table) { max-width: 70ch; }
  /* O plugin de tipografia desenha uma crase antes e depois de todo código; no wiki ela aparecia como texto. */
  .wk-prose code::before, .wk-prose code::after { content: none; }
  .wk-prose h1, .wk-prose h2, .wk-prose h3 { font-family: inherit; scroll-margin-top: 5.5rem; }
  .wk-prose h2 { font-family: 'Plus Jakarta Sans', system-ui, sans-serif; font-size: 1.25rem; font-weight: 800; margin-top: 1.8rem; padding-top: .8rem; border-top: 1px solid var(--border-subtle); }
  .wk-prose table { display: block; overflow-x: auto; font-family: 'Plus Jakarta Sans', system-ui, sans-serif; font-size: .82rem; line-height: 1.45; }
  .wk-prose table code { white-space: nowrap; }
  @media (max-width: 1024px) { .wk-doc { grid-template-columns: 12rem minmax(0, 1fr); } .wk-toc { display: none; } }
  @media (max-width: 820px) { .wk-goals { grid-template-columns: repeat(2, 1fr); } .wk-grid2 { grid-template-columns: 1fr; } }
  @media (max-width: 760px) {
    .wk-doc { grid-template-columns: 1fr; }
    .wk-side { position: static; max-height: none; border-bottom: 1px solid var(--border-default); padding-bottom: .6rem; }
    .wk-start { grid-template-columns: 1fr; text-align: center; } .wk-start img { margin: 0 auto; }
    .wk-work { margin-left: 0; }
  }
</style>

<script>
  import { escapeHtml as E, safeNavigationUrl } from '../lib/escape-html';
  import { renderWikiMarkdown, dropLeadingTitle, plainSnippet } from '../lib/wiki-render';
  import { youtubeWatchUrl, youtubeThumbUrl } from '../data/youtube-playlists';

  // ── base ───────────────────────────────────────────────────────────────────────────────────────
  const root = document.getElementById('wiki-root') as HTMLElement;
  const LANG = root.dataset.lang || 'pt-BR';
  const LOCALE = LANG === 'es-LATAM' ? 'es-419' : LANG;
  const I18N: Record<string, string> = (() => {
    try { return JSON.parse(document.getElementById('page-i18n')?.textContent || '{}'); } catch { return {}; }
  })();
  function T(key: string, vars?: Record<string, string | number>): string {
    let s = Object.prototype.hasOwnProperty.call(I18N, key) ? I18N[key] : key;
    if (vars) for (const [k, v] of Object.entries(vars)) s = s.split(`{${k}}`).join(String(v));
    return s;
  }

  const params = new URLSearchParams(location.search);
  const LANG_PARAM = params.get('lang');
  function href(p: Record<string, string | null | undefined> = {}): string {
    const u = new URLSearchParams();
    for (const [k, v] of Object.entries(p)) if (v) u.set(k, v);
    if (LANG_PARAM) u.set('lang', LANG_PARAM);
    const s = u.toString();
    return '/wiki' + (s ? `?${s}` : '');
  }
  const LINKS = { page: (p: string) => href({ page: p }), search: (q: string) => href({ q }) };

  let sb: any = null;
  let ctx: { is_committee: boolean; initiatives: any[] } = { is_committee: false, initiatives: [] };
  // Tribos e demais iniciativas do cadastro, com o estado da página de cada uma (emenda 3 da ADR-0129).
  let overview: any[] = [];
  let queue: { awaiting_my_decision: any[]; audit_pending: any[]; my_versions: any[] } =
    { awaiting_my_decision: [], audit_pending: [], my_versions: [] };
  let pages: any[] = [];
  // Sugestões de melhoria (fase B2): as que a pessoa responde e as que ela enviou (wiki_suggestion_queue).
  let sugg: { to_decide: any[]; mine: any[] } = { to_decide: [], mine: [] };

  const view = () => document.getElementById('wiki-view') as HTMLElement;
  const fmtDate = (s?: string | null) =>
    s ? new Date(s).toLocaleDateString(LOCALE, { day: '2-digit', month: '2-digit', year: 'numeric' }) : '';
  const errMsg = (e: any) => String(e?.message || e || '').replace(/^wiki:\s*/, '');
  const toast = (msg: string, kind: 'success' | 'error' | 'info' = 'success') => (window as any).toast?.(msg, kind);

  async function rpc(name: string, args?: Record<string, unknown>): Promise<any> {
    const { data, error } = await sb.rpc(name, args);
    if (error) throw error;
    return data;
  }

  // ── pedaços de interface ───────────────────────────────────────────────────────────────────────
  const BTN = 'inline-flex items-center px-4 py-2 rounded-lg text-sm font-semibold cursor-pointer no-underline disabled:opacity-50 disabled:cursor-not-allowed';
  const BTN_PRIMARY = `${BTN} bg-navy text-white border-0 hover:opacity-90`;
  const BTN_SECONDARY = `${BTN} border border-[var(--border-default)] bg-[var(--surface-card)] text-[var(--text-primary)] hover:bg-[var(--surface-hover)]`;
  const BTN_DANGER = `${BTN} bg-red-600 text-white border-0 hover:opacity-90`;
  const INPUT = 'w-full px-3 py-2 rounded-lg border border-[var(--border-default)] bg-[var(--surface-base)] text-[var(--text-primary)] text-sm';
  const CARD = 'rounded-xl border border-[var(--border-default)] bg-[var(--surface-card)] p-5';

  const STATUS_CLASS: Record<string, string> = {
    draft: 'bg-slate-100 text-slate-700',
    pending_leader: 'bg-amber-100 text-amber-800',
    pending_committee: 'bg-amber-100 text-amber-800',
    returned: 'bg-orange-100 text-orange-800',
    published: 'bg-emerald-100 text-emerald-800',
    superseded: 'bg-slate-100 text-slate-500',
    unpublished: 'bg-red-100 text-red-700',
  };
  const own = (o: Record<string, string>, k: unknown) =>
    Object.prototype.hasOwnProperty.call(o, String(k)) ? o[String(k)] : '';
  const chip = (text: string, cls: string) =>
    `<span class="inline-block px-2 py-0.5 rounded-full text-[.68rem] font-semibold ${cls}">${E(text)}</span>`;
  const statusChip = (s: string) => chip(T(`wiki.status.${s}`), own(STATUS_CLASS, s) || 'bg-slate-100 text-slate-700');
  const sourceChip = (repo: string) => repo === 'plataforma'
    ? chip(T('wiki.source.platform'), 'bg-blue-100 text-blue-800')
    : chip(T('wiki.source.repo'), 'bg-slate-100 text-slate-600');
  const auditChip = (s?: string | null) => s === 'pending'
    ? chip(T('wiki.audit.pendingShort'), 'bg-amber-100 text-amber-800')
    : s === 'audited' ? chip(T('wiki.audit.auditedShort'), 'bg-emerald-100 text-emerald-800') : '';
  const emptyBox = (msg: string) => `<p class="text-sm text-[var(--text-muted)] py-6 text-center">${E(msg)}</p>`;
  const errorBox = (msg: string) =>
    `<div class="rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">${E(msg)}</div>`;
  const backLink = (url: string, label: string) =>
    `<a href="${E(url)}" class="text-sm text-[var(--text-secondary)] no-underline hover:underline">&larr; ${E(label)}</a>`;

  function renderMd(md: string, path: string): string {
    return renderWikiMarkdown(dropLeadingTitle(md), path, LINKS);
  }

  function sourcesList(sources: any): string {
    const list = Array.isArray(sources) ? sources : [];
    if (!list.length) return '';
    const items = list.map((s: any) => {
      const label = String(s?.label || s?.url || '').trim();
      const url = safeNavigationUrl(s?.url);
      return `<li>${url ? `<a href="${E(url)}" target="_blank" rel="noopener noreferrer">${E(label)}</a>` : E(label)}</li>`;
    }).join('');
    return `<div class="mt-6"><h3 class="text-sm font-bold text-[var(--text-primary)] mb-1">${E(T('wiki.sources'))}</h3>
      <ul class="list-disc pl-5 text-sm text-[var(--text-secondary)] space-y-0.5">${items}</ul></div>`;
  }

  // ── tipo por objetivo (Diátaxis) e organização ─────────────────────────────────────────────────
  const DOC_TYPES = ['tutorial', 'how_to', 'reference', 'explanation'];
  const DOMAIN_ORDER = ['tribes', 'initiatives', 'research', 'governance', 'platform', 'partnerships', 'onboarding'];
  // O tipo vem da tag diataxis-<tipo> que o repositório do wiki grava no cabeçalho da página.
  function typeOf(p: any): string | null {
    const tag = (Array.isArray(p?.tags) ? p.tags : []).find((x: string) => /^diataxis-/.test(String(x)));
    const typ = tag ? String(tag).slice('diataxis-'.length) : '';
    return DOC_TYPES.includes(typ) ? typ : null;
  }
  const byTitle = (a: any, b: any) => String(a.title).localeCompare(String(b.title), LOCALE, { numeric: true });
  const domainLabel = (d: string) => I18N[`wiki.domain.${d}`] ?? d;
  // Página de tribo vinda do repositório: a versão da plataforma, quando existir, substitui.
  const isOldTribePage = (p: any) => p?.domain === 'tribes' && p?.source_repo !== 'plataforma';
  const typeChip = (typ: string | null) => typ ? `<span class="wk-chip wk-chip-type">${E(T(`wiki.docType.${typ}`))}</span>` : '';
  const oldChip = (p: any) => isOldTribePage(p) ? `<span class="wk-chip wk-chip-old">${E(T('wiki.oldVersion'))}</span>` : '';
  const pagesLabel = (n: number) => (n === 1 ? T('wiki.pagesOne') : T('wiki.pagesMany', { n }));
  const NIA_IMG = `<picture><source srcset="/assets/nia/nia-acenando.webp" type="image/webp"><img src="/assets/nia/nia-acenando.png" alt="${E(T('wiki.niaAlt'))}" width="100" height="164"></picture>`;

  // ── busca com sugestão enquanto digita ─────────────────────────────────────────────────────────
  const fold = (s: string) => String(s || '').normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
  // Destaque do trecho digitado: as três partes passam pelo escape; só a <mark> é nossa.
  function highlight(text: string, q: string): string {
    const k = fold(q.trim());
    const i = k ? fold(text).indexOf(k) : -1;
    if (i < 0) return E(text);
    return `${E(text.slice(0, i))}<mark>${E(text.slice(i, i + k.length))}</mark>${E(text.slice(i + k.length))}`;
  }
  function suggest(q: string): any[] {
    const k = fold(q.trim());
    if (!k) return [];
    const score = (p: any) => {
      const t = fold(p.title);
      if (t.startsWith(k)) return 3;
      if (t.includes(k)) return 2;
      return fold(p.summary || '').includes(k) ? 1 : 0;
    };
    return pages.map((p) => [p, score(p)] as const).filter(([, s]) => s > 0)
      .sort((a, b) => b[1] - a[1] || byTitle(a[0], b[0])).slice(0, 6).map(([p]) => p);
  }

  function mountSearch(host: HTMLElement | null, big: boolean, initial = '') {
    if (!host) return;
    const id = big ? 'wk-q-big' : 'wk-q-mini';
    host.innerHTML = `<form method="get" action="/wiki" class="wk-search" role="search">
      <svg class="wk-ico" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      <input id="${id}" name="q" type="search" autocomplete="off" role="combobox" aria-expanded="false" aria-controls="${id}-list"
        aria-label="${E(T('wiki.search'))}" placeholder="${E(T('wiki.searchPlaceholder'))}" value="${E(initial)}">
      ${LANG_PARAM ? `<input type="hidden" name="lang" value="${E(LANG_PARAM)}">` : ''}
      <kbd aria-hidden="true">/</kbd>
      <div class="wk-sugg" id="${id}-list" role="listbox" hidden></div>
    </form>`;
    const input = host.querySelector('input') as HTMLInputElement;
    const box = host.querySelector('.wk-sugg') as HTMLElement;
    let sel = -1; let list: any[] = [];
    const close = () => { box.hidden = true; input.setAttribute('aria-expanded', 'false'); sel = -1; };
    const paint = () => {
      const q = input.value;
      list = suggest(q);
      if (!q.trim()) { close(); return; }
      box.innerHTML = (list.length
        ? list.map((p, i) => `<a href="${E(href({ page: p.path }))}" role="option" aria-selected="${i === sel}">
            <div class="t">${highlight(p.title, q)}</div>
            <div class="s">${E([typeOf(p) ? T(`wiki.docType.${typeOf(p)}`) : '', domainLabel(p.domain)].filter(Boolean).join(' · '))}</div></a>`).join('')
          + `<a href="${E(href({ q }))}" class="all">${E(T('wiki.seeAllResults', { q }))}</a>`
        : `<p class="text-sm text-[var(--text-muted)] p-3">${E(T('wiki.noSuggestion', { q }))}</p>`);
      box.hidden = false; input.setAttribute('aria-expanded', 'true');
    };
    input.addEventListener('input', () => { sel = -1; paint(); });
    input.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') { e.preventDefault(); sel = Math.min(sel + 1, list.length - 1); paint(); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); sel = Math.max(sel - 1, -1); paint(); }
      else if (e.key === 'Enter' && sel >= 0 && list[sel]) { e.preventDefault(); location.href = href({ page: list[sel].path }); }
      else if (e.key === 'Escape') { close(); }
    });
    input.addEventListener('blur', () => setTimeout(close, 150));
  }
  // "/" leva à busca do wiki; Ctrl/Cmd+K continua com a busca global do site.
  document.addEventListener('keydown', (e) => {
    if (e.key !== '/' || e.ctrlKey || e.metaKey || e.altKey) return;
    const el = e.target as HTMLElement | null;
    if (el && (el.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(el.tagName))) return;
    const input = (document.getElementById('wk-q-big') || document.getElementById('wk-q-mini')) as HTMLInputElement | null;
    if (input) { e.preventDefault(); input.focus(); }
  });

  // ── barra de trabalho (minhas versões, fila da liderança, fila do comitê) ──────────────────────
  function currentTab(): string {
    const tab = params.get('tab');
    if (tab === 'mine' || tab === 'decide' || tab === 'audit') return tab;
    return '';
  }

  function workItems() {
    const items: { key: string; label: string; url: string; count: number }[] = [];
    if (ctx.initiatives.length || queue.my_versions.length || sugg.mine.length)
      items.push({ key: 'mine', label: T('wiki.tab.mine'), url: href({ tab: 'mine' }), count: queue.my_versions.length });
    if (ctx.is_committee || ctx.initiatives.some((t) => t.is_leader) || queue.awaiting_my_decision.length || sugg.to_decide.length)
      items.push({ key: 'decide', label: T('wiki.tab.decide'), url: href({ tab: 'decide' }),
        count: queue.awaiting_my_decision.length + sugg.to_decide.length });
    if (ctx.is_committee)
      items.push({ key: 'audit', label: T('wiki.tab.audit'), url: href({ tab: 'audit' }), count: queue.audit_pending.length });
    return items;
  }

  function renderTabs() {
    const active = currentTab();
    (document.getElementById('wiki-tabs') as HTMLElement).innerHTML = workItems().map((it) =>
      `<a href="${E(it.url)}" ${it.key === active ? 'aria-current="page"' : ''}>${E(it.label)}${it.count ? `<span class="wk-count">${it.count}</span>` : ''}</a>`).join('');
  }

  // ── início ─────────────────────────────────────────────────────────────────────────────────────
  function myTribesCallout(): string {
    const mine = ctx.initiatives.filter((t) => t.is_engaged && t.status === 'active');
    if (!mine.length) return '';
    const rows = mine.map((t) => {
      const exists = pages.some((p) => p.path === t.path_prefix);
      const action = exists
        ? `<a href="${E(href({ page: t.path_prefix }))}" class="${BTN_SECONDARY} !py-1 !px-3 !text-xs">${E(T('wiki.viewPage'))}</a>`
        : `<a href="${E(href({ new: t.id, path: t.path_prefix }))}" class="${BTN_PRIMARY} !py-1 !px-3 !text-xs">${E(T('wiki.createTribePage'))}</a>`;
      return `<li class="flex items-center justify-between gap-3 py-1.5"><span class="text-sm text-[var(--text-primary)]">${E(t.title)}</span>${action}</li>`;
    }).join('');
    return `<div class="${CARD} !p-4 max-w-3xl mx-auto mb-5"><h2 class="text-sm font-bold text-[var(--text-primary)]">${E(T('wiki.myTribePages'))}</h2>
      <p class="text-[.75rem] text-[var(--text-muted)] mb-1">${E(T('wiki.myTribePagesHint'))}</p><ul>${rows}</ul></div>`;
  }

  // O aviso mais urgente de quem tem trabalho no wiki; a fila completa fica na barra de trabalho.
  function callout(): string {
    const box = (msg: string, url: string) =>
      `<div class="wk-callout"><p>${E(msg)}</p><a class="wk-btn wk-btn-primary" href="${E(url)}">${E(T('wiki.calloutOpen'))}</a></div>`;
    if (queue.awaiting_my_decision.length) return box(T('wiki.calloutDecide', { n: queue.awaiting_my_decision.length }), href({ tab: 'decide' }));
    if (sugg.to_decide.length) return box(T('wiki.calloutSuggestions', { n: sugg.to_decide.length }), href({ tab: 'decide' }));
    if (ctx.is_committee && queue.audit_pending.length) return box(T('wiki.calloutAudit', { n: queue.audit_pending.length }), href({ tab: 'audit' }));
    const open = queue.my_versions.length;
    if (open) return box(T('wiki.calloutMine', { n: open }), href({ tab: 'mine' }));
    return '';
  }

  // Uma linha da lista de tribos e iniciativas: o estado da página vem do cadastro (wiki_initiatives_overview),
  // e não das páginas que já existem, senão quem ainda não escreveu some da lista.
  function initiativeRow(x: any): string {
    const page = x.platform_page || x.repo_page;
    const name = page ? `<a href="${E(href({ page }))}">${E(x.title)}</a>` : `<span class="font-semibold text-sm">${E(x.title)}</span>`;
    const sub = x.kind === 'research_tribe' ? '' : `<div class="sm">${E(T(`wiki.kind.${x.kind}`))}</div>`;
    const muted = (key: string) => `<span class="wk-chip wk-chip-muted">${E(T(key))}</span>`;
    const chips = [
      x.status !== 'active' ? muted('wiki.frozen') : '',
      x.platform_page ? `<span class="wk-chip wk-chip-ok">${E(T('wiki.onPlatform'))}</span>`
        : x.repo_page ? `<span class="wk-chip wk-chip-old">${E(T('wiki.oldVersion'))}</span>` : muted('wiki.noPageYet'),
      x.status === 'active' && !x.has_team ? muted('wiki.noTeam') : '',
      x.status === 'active' && x.can_author && !x.platform_page
        ? `<a class="wk-chip wk-chip-type" href="${E(href({ new: x.id, path: x.path_prefix }))}">${E(T('wiki.writeFirstVersion'))}</a>` : '',
    ].filter(Boolean).join('');
    return `<li><div>${name}${sub}</div><span class="inline-flex gap-1 flex-wrap justify-end">${chips}</span></li>`;
  }

  function viewHome() {
    const tribes = overview.filter((x) => x.kind === 'research_tribe');
    const others = overview.filter((x) => x.kind !== 'research_tribe');
    const latest = pages.reduce((m, p) => (p.updated_at && p.updated_at > m ? p.updated_at : m), '');
    const recent = [...pages].sort((a, b) => String(b.updated_at || '').localeCompare(String(a.updated_at || ''))).slice(0, 5);
    const goals = DOC_TYPES.map((typ) => {
      const n = pages.filter((p) => typeOf(p) === typ).length;
      return `<a class="wk-goal" href="${E(href({ type: typ }))}"><span class="verb">${E(T(`wiki.goal.${typ}`))}</span>
        <span class="what">${E(T(`wiki.docTypeHint.${typ}`))}</span><span class="n">${E(pagesLabel(n))} · ${E(T(`wiki.docType.${typ}`))}</span></a>`;
    }).join('');
    const work = workItems();
    view().innerHTML = `
      <section class="wk-hero">
        <h1 class="wk-serif">${E(T('wiki.title'))}</h1>
        <p class="sub">${E(T('wiki.heroSubtitle'))}</p>
        <div data-search="big"></div>
        <div class="wk-stats">${E(T('wiki.stats', { pages: pages.length, tribes: tribes.filter((x) => x.platform_page || x.repo_page).length, date: fmtDate(latest) }))}</div>
        ${work.length ? `<nav class="wk-work justify-center mt-3" aria-label="${E(T('wiki.workNav'))}" style="margin-left:0">${work.map((it) =>
          `<a href="${E(it.url)}">${E(it.label)}${it.count ? `<span class="wk-count">${it.count}</span>` : ''}</a>`).join('')}</nav>` : ''}
      </section>
      ${callout()}${myTribesCallout()}
      <h2 class="wk-h2">${E(T('wiki.goalsTitle'))}</h2>
      <div class="wk-goals">${goals}</div>
      <div class="wk-grid2">
        <div class="wk-panel wk-start">${NIA_IMG}
          <div><h3>${E(T('wiki.startTitle'))}</h3>
            <ol><li>${E(T('wiki.startStep1'))}</li><li>${E(T('wiki.startStep2'))}</li><li>${E(T('wiki.startStep3'))}</li></ol>
            <a class="wk-video" href="${E(youtubeWatchUrl('wikiWelcome'))}" target="_blank" rel="noopener noreferrer">
              <span class="thumb"><img src="${E(youtubeThumbUrl('wikiWelcome'))}" srcset="${E(youtubeThumbUrl('wikiWelcome'))} 320w, ${E(youtubeThumbUrl('wikiWelcome', 'maxresdefault'))} 1280w" sizes="(max-width: 760px) 90vw, 320px" alt="${E(T('wiki.videoAlt'))}" width="320" height="180" loading="lazy"><span class="play" aria-hidden="true">&#9654;</span></span>
              <span><strong>${E(T('wiki.videoTitle'))}</strong><br>${E(T('wiki.videoDesc'))}</span>
            </a>
          </div></div>
        <div class="wk-panel"><h2 class="wk-h2">${E(T('wiki.tribesTitle'))}</h2>
          ${tribes.length ? `<ul class="wk-list">${tribes.map(initiativeRow).join('')}</ul>` : emptyBox(T('wiki.noPages'))}
        </div>
      </div>
      ${others.length ? `<div class="wk-panel"><h2 class="wk-h2">${E(T('wiki.initiativesTitle'))}</h2>
        <ul class="wk-list">${others.map(initiativeRow).join('')}</ul></div>` : ''}
      <div class="wk-panel"><h2 class="wk-h2">${E(T('wiki.recentTitle'))}</h2>
        ${recent.length ? `<ul class="wk-list">${recent.map((p) => `<li><div><a href="${E(href({ page: p.path }))}">${E(p.title)}</a>
          <div class="sm">${E([typeOf(p) ? T(`wiki.docType.${typeOf(p)}`) : '', domainLabel(p.domain)].filter(Boolean).join(' · '))}</div></div>
          <span class="when">${E(fmtDate(p.updated_at))}</span></li>`).join('')}</ul>` : emptyBox(T('wiki.noPages'))}
      </div>`;
    mountSearch(view().querySelector('[data-search="big"]') as HTMLElement, true);
  }

  // ── resultados ─────────────────────────────────────────────────────────────────────────────────
  function pageItem(p: any, q: string, headline?: string): string {
    // O trecho vem do ts_headline sobre o markdown: vira texto puro e ganha o destaque da tela.
    const snippet = plainSnippet(headline);
    const lead = snippet
      ? `<p>${highlight(snippet, q)}</p>`
      : p.summary ? `<p>${highlight(p.summary, q)}</p>` : '';
    return `<div class="wk-hit"><div class="crumb">${E(domainLabel(p.domain))}</div>
      <a class="h" href="${E(href({ page: p.path }))}">${highlight(p.title, q)}</a>${lead}
      <span class="inline-flex gap-1 flex-wrap">${typeChip(typeOf(p))}${oldChip(p)}${auditChip(p.audit_status)}</span></div>`;
  }

  async function viewResults(q: string, typ: string) {
    const byPath = new Map(pages.map((p) => [p.path, p]));
    let items: { p: any; headline?: string }[];
    if (q) {
      const results: any[] = (await rpc('search_wiki_pages', { p_query: q, p_limit: 30 })) || [];
      items = results.map((r) => ({ p: { ...r, ...(byPath.get(r.path) || {}) }, headline: r.headline }));
    } else {
      items = [...pages].sort(byTitle).map((p) => ({ p }));
    }
    if (typ) items = items.filter((it) => typeOf(it.p) === typ);
    const title = q ? T('wiki.resultsFor', { n: items.length, q })
      : typ ? T('wiki.typeResults', { goal: T(`wiki.goal.${typ}`), label: T(`wiki.docType.${typ}`) }) : T('wiki.tab.pages');
    const filters = [['', T('wiki.filterAll')], ...DOC_TYPES.map((d) => [d, T(`wiki.goal.${d}`)])]
      .map(([d, label]) => `<a href="${E(href({ q, type: d }))}" aria-current="${(typ || '') === d}">${E(label)}</a>`).join('');
    view().innerHTML = `<section class="wk-results">
      <h1 class="wk-serif">${E(title)}</h1>
      <nav class="wk-filters" aria-label="${E(T('wiki.fieldDocType'))}">${filters}</nav>
      ${items.length ? items.map((it) => pageItem(it.p, q, it.headline)).join('') : emptyBox(T('wiki.noResults'))}
    </section>`;
  }

  // ── leitura de uma página (3 colunas) ──────────────────────────────────────────────────────────
  function historyList(hist: any, currentId?: string | null): string {
    const versions: any[] = hist?.versions || [];
    if (!versions.length) return '';
    const rows = versions.map((v) => `
      <li class="flex flex-wrap items-center gap-2 py-1.5 border-b border-[var(--border-subtle)] last:border-0">
        <a href="${E(href({ version: v.id }))}" class="text-sm font-semibold text-[var(--text-primary)] no-underline hover:underline">${E(T('wiki.versionN', { n: v.version_no }))}</a>
        ${statusChip(v.status)}${v.id === currentId ? chip(T('wiki.current'), 'bg-blue-100 text-blue-800') : ''}
        <span class="text-[.72rem] text-[var(--text-muted)]">${E(v.author || '')}${v.published_at ? ' · ' + E(fmtDate(v.published_at)) : v.updated_at ? ' · ' + E(fmtDate(v.updated_at)) : ''}</span>
      </li>`).join('');
    return `<div class="${CARD} mt-6"><h3 class="text-sm font-bold text-[var(--text-primary)] mb-1">${E(T('wiki.history'))}</h3><ul>${rows}</ul></div>`;
  }

  function auditBanner(status: string | null | undefined, due?: string | null): string {
    if (status === 'pending') {
      const msg = due ? T('wiki.audit.pending', { date: fmtDate(due) }) : T('wiki.audit.pendingNoDate');
      return `<div class="rounded-lg border border-amber-200 bg-amber-50 px-4 py-2 text-[.8rem] text-amber-900">${E(msg)}</div>`;
    }
    if (status === 'audited')
      return `<div class="rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-2 text-[.8rem] text-emerald-900">${E(T('wiki.audit.audited'))}</div>`;
    return '';
  }

  function sideNav(activePath: string): string {
    const groups = new Map<string, any[]>();
    for (const p of pages) { if (!groups.has(p.domain)) groups.set(p.domain, []); groups.get(p.domain)!.push(p); }
    const order = [...DOMAIN_ORDER.filter((d) => groups.has(d)), ...[...groups.keys()].filter((d) => !DOMAIN_ORDER.includes(d)).sort()];
    return `<nav class="wk-side" aria-label="${E(T('wiki.pagesNav'))}">${order.map((d) => `<h4>${E(domainLabel(d))}</h4>
      ${groups.get(d)!.sort(byTitle).map((p) => `<a href="${E(href({ page: p.path }))}" ${p.path === activePath ? 'aria-current="page"' : ''}>
        <span>${E(p.title)}</span></a>`).join('')}`).join('')}</nav>`;
  }

  // Texto para colar no assistente do Núcleo. Vai para a área de transferência, nunca para o HTML.
  function assistantMarkdown(md: string, title: string, summary: string, url: string): string {
    return `# ${title}\n\n${summary ? `> ${summary}\n\n` : ''}${dropLeadingTitle(md)}\n\n---\n${T('wiki.title')}: ${url}`;
  }

  function buildToc() {
    const prose = document.getElementById('wk-prose');
    const toc = document.getElementById('wk-toc-list');
    if (!prose || !toc) return;
    const heads = [...prose.querySelectorAll('h2, h3')] as HTMLElement[];
    const used = new Set<string>();
    const links = heads.map((h, i) => {
      let id = fold(h.textContent || '').replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '').slice(0, 60) || `secao-${i + 1}`;
      while (used.has(id)) id += '-' + (i + 1);
      used.add(id); h.id = id;
      return `<a href="#${E(id)}" class="${h.tagName === 'H3' ? 'sub' : ''}" data-toc="${E(id)}">${E(h.textContent || '')}</a>`;
    });
    if (!links.length) { toc.parentElement?.querySelector('h4')?.remove(); return; }
    toc.innerHTML = links.join('');
    const anchors = [...toc.querySelectorAll('a')] as HTMLElement[];
    const spy = () => {
      let cur = 0;
      heads.forEach((h, i) => { if (h.getBoundingClientRect().top < 120) cur = i; });
      anchors.forEach((a, i) => a.classList.toggle('on', i === cur));
    };
    window.addEventListener('scroll', spy, { passive: true });
    spy();
  }

  async function viewPage(path: string) {
    const { data: rows, error } = await sb.from('wiki_pages').select('*').eq('path', path).limit(1);
    if (error) throw error;
    const row = rows?.[0] || null;
    const isPlatform = path.startsWith('nucleo/');
    const hist = isPlatform ? await rpc('wiki_page_history', { p_page_path: path }) : null;
    const cur = row?.platform_version_id ? await rpc('wiki_get_version', { p_version_id: row.platform_version_id }) : null;

    if (!row && !hist?.versions?.length) {
      view().innerHTML = `${backLink(href(), T('wiki.tab.pages'))}<div class="mt-4">${emptyBox(T('wiki.notFound'))}</div>`;
      return;
    }

    const typ = cur?.doc_type && DOC_TYPES.includes(cur.doc_type) ? cur.doc_type : typeOf(row);
    const edit = isPlatform && hist?.can_author && hist?.initiative
      ? `<a href="${E(href({ new: hist.initiative.id, path }))}" class="wk-btn wk-btn-primary">${E(T(row ? 'wiki.edit' : 'wiki.writeFirstVersion'))}</a>` : '';
    const copyBtn = row ? `<button type="button" class="wk-btn wk-btn-ghost" data-copy>${E(T('wiki.copyForAssistant'))}</button>` : '';
    const suggestBtn = row ? `<button type="button" class="wk-btn wk-btn-ghost" data-suggest-open>${E(T('wiki.suggest'))}</button>` : '';
    // A sugestão não entra na página: só quem sugeriu e quem decide sobre ela a enxergam.
    const suggestForm = row ? `
      <div id="wk-suggest" class="${CARD} !p-4 mb-4 hidden">
        <label for="wk-suggest-body" class="text-sm font-bold text-[var(--text-primary)]">${E(T('wiki.suggestTitle'))}</label>
        <p class="text-[.75rem] text-[var(--text-muted)] mb-2">${E(T('wiki.suggestHint'))}</p>
        <textarea id="wk-suggest-body" rows="4" maxlength="2000" class="${INPUT}" placeholder="${E(T('wiki.suggestPlaceholder'))}"></textarea>
        <div class="flex gap-2 mt-2">
          <button type="button" class="${BTN_PRIMARY}" data-suggest-send>${E(T('wiki.suggestSend'))}</button>
          <button type="button" class="${BTN_SECONDARY}" data-suggest-cancel>${E(T('wiki.cancel'))}</button>
        </div>
      </div>` : '';

    const meta = row ? [
      typeChip(typ),
      row.source_repo ? sourceChip(row.source_repo) : '',
      hist?.initiative ? E(hist.initiative.title) : '',
      row.authors?.length ? E(T('wiki.byAuthors', { names: row.authors.join(', ') })) : '',
      row.updated_at ? E(T('wiki.updatedAt', { date: fmtDate(row.updated_at) })) : '',
      row.license ? E(row.license) : '',
    ].filter(Boolean).join(' <span class="text-[var(--text-muted)]">·</span> ') : '';

    const seal = isPlatform ? auditBanner(row?.audit_status, cur?.audit_due_at)
      : isOldTribePage(row) ? `<div class="wk-seal">${E(T('wiki.oldSeal'))}</div>` : '';

    const article = row ? `
      <div class="wk-crumbs"><a href="${E(href())}">${E(T('wiki.title'))}</a> › <span>${E(domainLabel(row.domain))}</span></div>
      <h1 class="wk-serif">${E(row.title)}</h1>
      <div class="wk-meta">${meta}</div>
      ${seal}
      <div class="wk-actions">${edit}${copyBtn}${suggestBtn}</div>
      ${suggestForm}
      ${row.summary ? `<p class="wk-lead wk-serif">${E(row.summary)}</p>` : ''}
      <div id="wk-prose" class="wk-prose prose prose-sm max-w-none text-[var(--text-primary)]">${renderMd(row.content, path)}</div>
      ${sourcesList(cur?.sources)}`
      : `<div class="wk-actions">${edit}</div><div class="${CARD}">${emptyBox(T('wiki.notPublished'))}</div>`;

    view().innerHTML = `<div class="wk-doc">${sideNav(path)}
      <article class="wk-article">${article}${historyList(hist, row?.platform_version_id)}</article>
      <aside class="wk-toc" aria-label="${E(T('wiki.onThisPage'))}"><h4>${E(T('wiki.onThisPage'))}</h4><div id="wk-toc-list"></div>
        ${row ? `<button type="button" data-copy>${E(T('wiki.copyForAssistant'))}</button>` : ''}</aside></div>`;
    buildToc();

    view().querySelectorAll('[data-copy]').forEach((b) => b.addEventListener('click', () => {
      const url = location.origin + href({ page: path });
      navigator.clipboard.writeText(assistantMarkdown(row.content, row.title, row.summary || '', url))
        .then(() => toast(T('wiki.copied')))
        .catch(() => toast(T('wiki.copyFailed'), 'error'));
    }));

    const form = document.getElementById('wk-suggest');
    const text = document.getElementById('wk-suggest-body') as HTMLTextAreaElement | null;
    view().querySelector('[data-suggest-open]')?.addEventListener('click', () => { form?.classList.remove('hidden'); text?.focus(); });
    form?.querySelector('[data-suggest-cancel]')?.addEventListener('click', () => form.classList.add('hidden'));
    form?.querySelector('[data-suggest-send]')?.addEventListener('click', async (ev) => {
      const btn = ev.currentTarget as HTMLButtonElement;
      const body = (text?.value || '').trim();
      if (body.length < 10) { toast(T('wiki.suggestTooShort'), 'error'); return; }
      btn.disabled = true;
      try {
        const r = await rpc('wiki_suggest', { p_page_path: path, p_body: body });
        toast(T(r?.route === 'committee' ? 'wiki.suggestSentCommittee' : 'wiki.suggestSentLeader'));
        if (text) text.value = '';
        form.classList.add('hidden');
        await refreshSuggestions();
      } catch (e) {
        toast(errMsg(e) || T('wiki.loadError'), 'error');
      } finally {
        btn.disabled = false;
      }
    });
  }

  // ── uma versão e suas ações ────────────────────────────────────────────────────────────────────
  function timeline(events: any[]): string {
    if (!events?.length) return '';
    const rows = events.map((e) => `
      <li class="py-1.5 border-b border-[var(--border-subtle)] last:border-0 text-[.78rem]">
        <span class="font-semibold text-[var(--text-primary)]">${E(T(`wiki.event.${e.action}`))}</span>
        <span class="text-[var(--text-muted)]"> · ${E(e.actor || T('wiki.system'))} · ${E(fmtDate(e.at))}</span>
        ${e.reason ? `<p class="text-[var(--text-secondary)] mt-0.5">${E(e.reason)}</p>` : ''}
      </li>`).join('');
    return `<div class="${CARD}"><h3 class="text-sm font-bold text-[var(--text-primary)] mb-1">${E(T('wiki.timeline'))}</h3><ul>${rows}</ul></div>`;
  }

  async function viewVersion(id: string) {
    const v = await rpc('wiki_get_version', { p_version_id: id });
    const hist = await rpc('wiki_page_history', { p_page_path: v.page_path });
    const meta = (hist?.versions || []).find((x: any) => x.id === id) || {};
    const mine = queue.my_versions.find((x) => x.id === id);
    const mineOpen = !!mine && (mine.status === 'draft' || mine.status === 'returned');
    const minePending = !!mine && (mine.status === 'pending_leader' || mine.status === 'pending_committee');
    const toDecide = queue.awaiting_my_decision.some((x) => x.id === id);
    const toAudit = queue.audit_pending.some((x) => x.id === id);
    const lastReturn = [...(v.events || [])].reverse().find((e: any) => e.action === 'returned');

    let panel = '';
    if (mineOpen) {
      panel = `
        <div class="${CARD} space-y-3">
          ${v.status === 'returned' && lastReturn ? `<div class="rounded-lg border border-orange-200 bg-orange-50 px-4 py-2 text-[.8rem] text-orange-900">${E(T('wiki.returnedBecause', { reason: lastReturn.reason || '' }))}</div>` : ''}
          <p class="text-[.8rem] text-[var(--text-secondary)]">${E(T('wiki.flowHint'))}</p>
          <div class="flex flex-wrap gap-2">
            <a href="${E(href({ edit: id }))}" class="${BTN_SECONDARY}">${E(T('wiki.edit'))}</a>
            <button type="button" id="w-submit" class="${BTN_PRIMARY}">${E(T('wiki.submit'))}</button>
          </div>
        </div>`;
    } else if (minePending) {
      panel = `<div class="rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-[.8rem] text-amber-900">${E(T(mine?.status === 'pending_committee' ? 'wiki.waitingCommittee' : 'wiki.waitingLeader'))}</div>`;
    } else if (toDecide) {
      panel = `
        <div class="${CARD} space-y-3">
          <h3 class="text-sm font-bold text-[var(--text-primary)]">${E(T('wiki.decideTitle'))}</h3>
          <p class="text-[.8rem] text-[var(--text-secondary)]">${E(T(ctx.is_committee ? 'wiki.decideHintCommittee' : 'wiki.decideHintLeader'))}</p>
          <label class="block text-[.78rem] font-semibold text-[var(--text-secondary)]" for="w-reason">${E(T('wiki.reasonReturn'))}</label>
          <textarea id="w-reason" rows="2" class="${INPUT}"></textarea>
          <div class="flex flex-wrap gap-2">
            <button type="button" id="w-publish" class="${BTN_PRIMARY}">${E(T('wiki.publish'))}</button>
            <button type="button" id="w-return" class="${BTN_SECONDARY}">${E(T('wiki.return'))}</button>
          </div>
        </div>`;
    } else if (toAudit) {
      const overdue = v.audit_due_at && new Date(v.audit_due_at) < new Date();
      panel = `
        <div class="${CARD} space-y-3">
          <h3 class="text-sm font-bold text-[var(--text-primary)]">${E(T('wiki.auditTitle'))}</h3>
          <p class="text-[.8rem] ${overdue ? 'text-red-700 font-semibold' : 'text-[var(--text-secondary)]'}">${E(T(overdue ? 'wiki.auditOverdue' : 'wiki.auditDue', { date: fmtDate(v.audit_due_at) }))}</p>
          <label class="block text-[.78rem] font-semibold text-[var(--text-secondary)]" for="w-reason">${E(T('wiki.reasonAudit'))}</label>
          <textarea id="w-reason" rows="2" class="${INPUT}"></textarea>
          <div class="flex flex-wrap gap-2">
            <button type="button" id="w-keep" class="${BTN_PRIMARY}">${E(T('wiki.auditKeep'))}</button>
            <a href="${E(href({ alter: id }))}" class="${BTN_SECONDARY}">${E(T('wiki.auditAlter'))}</a>
            <button type="button" id="w-unpublish" class="${BTN_DANGER}">${E(T('wiki.auditUnpublish'))}</button>
          </div>
        </div>`;
    }

    const pageLink = v.status === 'published' || v.status === 'superseded'
      ? `<a href="${E(href({ page: v.page_path }))}" class="${BTN_SECONDARY}">${E(T('wiki.openPage'))}</a>` : '';

    view().innerHTML = `
      <div class="flex items-center justify-between gap-3 mb-3">${backLink(href({ page: v.page_path }), T('wiki.backToPage'))}${pageLink}</div>
      <div class="space-y-4 max-w-4xl">
        ${panel}
        <article class="${CARD} space-y-3">
          <div class="flex flex-wrap items-center gap-2">${statusChip(v.status)}
            <span class="text-[.75rem] text-[var(--text-muted)]">${E(T('wiki.versionOf', { n: v.version_no, path: v.page_path }))}</span></div>
          <h2 class="text-xl font-extrabold text-[var(--text-primary)]">${E(v.title)}</h2>
          <div class="text-[.75rem] text-[var(--text-secondary)]">${[
            hist?.initiative ? E(hist.initiative.title) : '',
            meta.author ? E(T('wiki.byAuthors', { names: meta.author })) : '',
            v.doc_type ? E(T(`wiki.docType.${v.doc_type}`)) : '',
          ].filter(Boolean).join(' · ')}</div>
          ${v.pii_detail ? `<div class="rounded-lg border border-red-200 bg-red-50 px-4 py-2 text-[.8rem] text-red-800">${E(T('wiki.piiWarning', { what: v.pii_detail }))}</div>` : ''}
          ${v.status === 'published' ? auditBanner(v.audited_at ? 'audited' : 'pending', v.audit_due_at) : ''}
          ${v.summary ? `<p class="text-sm italic text-[var(--text-secondary)]">${E(v.summary)}</p>` : ''}
          <div class="prose prose-sm max-w-none text-[var(--text-primary)]">${renderMd(v.content, v.page_path)}</div>
          ${sourcesList(v.sources)}
        </article>
        ${timeline(v.events)}
        ${historyList(hist, id)}
      </div>`;

    const reasonOf = () => ((document.getElementById('w-reason') as HTMLTextAreaElement | null)?.value || '').trim();
    const act = (btnId: string, fn: () => Promise<void>) => {
      const b = document.getElementById(btnId) as HTMLButtonElement | null;
      b?.addEventListener('click', async () => {
        b.disabled = true;
        try { await fn(); } catch (e) { toast(errMsg(e), 'error'); b.disabled = false; }
      });
    };
    act('w-submit', async () => {
      const r = await rpc('wiki_submit', { p_version_id: id });
      toast(T(r?.route === 'committee' ? 'wiki.submittedCommittee' : 'wiki.submittedLeader'));
      location.href = href({ version: id });
    });
    act('w-publish', async () => {
      await rpc('wiki_decide', { p_version_id: id, p_decision: 'publish' });
      toast(T('wiki.publishedToast'));
      location.href = href({ page: v.page_path });
    });
    act('w-return', async () => {
      if (!reasonOf()) throw new Error(T('wiki.reasonRequired'));
      await rpc('wiki_decide', { p_version_id: id, p_decision: 'return', p_reason: reasonOf() });
      toast(T('wiki.returnedToast'));
      location.href = href({ tab: 'decide' });
    });
    act('w-keep', async () => {
      await rpc('wiki_audit', { p_version_id: id, p_outcome: 'kept', p_reason: reasonOf() || null });
      toast(T('wiki.keptToast'));
      location.href = href({ tab: 'audit' });
    });
    // Despublicar pede um segundo clique no mesmo botão (sem diálogo do navegador).
    const un = document.getElementById('w-unpublish') as HTMLButtonElement | null;
    un?.addEventListener('click', async () => {
      if (un.dataset.armed !== '1') { un.dataset.armed = '1'; un.textContent = T('wiki.confirmUnpublish'); return; }
      un.disabled = true;
      try {
        if (!reasonOf()) throw new Error(T('wiki.reasonRequired'));
        await rpc('wiki_audit', { p_version_id: id, p_outcome: 'unpublished', p_reason: reasonOf() });
        toast(T('wiki.unpublishedToast'));
        location.href = href({ tab: 'audit' });
      } catch (e) { toast(errMsg(e), 'error'); un.disabled = false; }
    });
  }

  // ── editor ─────────────────────────────────────────────────────────────────────────────────────
  function slugify(s: string): string {
    return s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase()
      .replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '').slice(0, 80);
  }

  function sourceRow(s: { label?: string; url?: string } = {}, disabled = false): string {
    const dis = disabled ? 'disabled' : '';
    return `<div class="w-source flex gap-2">
      <input class="${INPUT} w-src-label" placeholder="${E(T('wiki.sourceLabel'))}" value="${E(s.label || '')}" ${dis}>
      <input class="${INPUT} w-src-url" placeholder="https://…" value="${E(s.url || '')}" ${dis}>
      ${disabled ? '' : `<button type="button" class="w-src-del ${BTN_SECONDARY} !px-3" aria-label="${E(T('wiki.removeSource'))}">&times;</button>`}
    </div>`;
  }

  type EditorOpts = { mode: 'edit' | 'alter' | 'new'; id?: string; initiative?: string; path?: string | null };

  async function viewEditor(o: EditorOpts) {
    // domain só existe na página nova (vem de wiki_authoring_context); editar sai antes da checagem de domínio.
    let tribe: { id: string; title: string; path_prefix?: string; domain?: string } | null = null;
    let path: string | null = o.path || null;
    let base: any = null; // versão que preenche o formulário

    if (o.mode === 'edit' || o.mode === 'alter') {
      base = await rpc('wiki_get_version', { p_version_id: o.id });
      const hist = await rpc('wiki_page_history', { p_page_path: base.page_path });
      tribe = hist?.initiative || null;
      path = base.page_path;
      const allowed = o.mode === 'edit'
        ? queue.my_versions.some((x) => x.id === o.id && (x.status === 'draft' || x.status === 'returned'))
        : queue.audit_pending.some((x) => x.id === o.id);
      if (!allowed) {
        view().innerHTML = `${backLink(href({ version: o.id }), T('wiki.backToVersion'))}<div class="mt-4">${errorBox(T(o.mode === 'edit' ? 'wiki.cannotEdit' : 'wiki.cannotAlter'))}</div>`;
        return;
      }
    } else {
      const t = ctx.initiatives.find((x) => x.id === o.initiative);
      if (!t) { view().innerHTML = errorBox(T('wiki.notYourTribe')); return; }
      tribe = t;
      if (path) {
        const open = queue.my_versions.find((x) => x.page_path === path);
        if (open && (open.status === 'draft' || open.status === 'returned')) { location.replace(href({ edit: open.id })); return; }
        if (open) {
          view().innerHTML = `<div class="${CARD}">${E(T('wiki.alreadyPending'))} <a href="${E(href({ version: open.id }))}">${E(T('wiki.openVersion'))}</a></div>`;
          return;
        }
        const row = pages.find((p) => p.path === path);
        if (row?.platform_version_id) base = await rpc('wiki_get_version', { p_version_id: row.platform_version_id });
      }
    }

    const alter = o.mode === 'alter';
    const prefix = (tribe as any)?.path_prefix || '';
    const pathField = path
      ? `<code class="text-[.78rem]">${E(path)}</code>`
      : `<span class="inline-flex items-center gap-1 flex-wrap"><code class="text-[.78rem]">${E(prefix)}/</code>
           <input id="w-slug" class="${INPUT} !w-56 !py-1" placeholder="${E(T('wiki.slugPlaceholder'))}"></span>
         <p class="text-[.72rem] text-[var(--text-muted)] mt-1">${E(T('wiki.slugHint'))}</p>`;
    const sources: any[] = Array.isArray(base?.sources) && base.sources.length ? base.sources : [{}];

    const cancelUrl = o.mode === 'new'
      ? (path && pages.some((p) => p.path === path) ? href({ page: path }) : href({ tab: 'mine' }))
      : href({ version: o.id });
    view().innerHTML = `
      ${backLink(cancelUrl, T('wiki.cancel'))}
      <form id="w-form" class="${CARD} space-y-4 mt-3 max-w-4xl" novalidate>
        <h2 class="text-lg font-extrabold text-[var(--text-primary)]">${E(T(alter ? 'wiki.alterTitle' : o.mode === 'edit' ? 'wiki.editDraftTitle' : base ? 'wiki.newVersionTitle' : 'wiki.newPageTitle'))}</h2>
        <div class="text-[.8rem] text-[var(--text-secondary)] space-y-1">
          <div><strong>${E(T('wiki.tribe'))}:</strong> ${E(tribe?.title || '')}</div>
          <div><strong>${E(T('wiki.path'))}:</strong> ${pathField}</div>
        </div>
        <label class="block"><span class="text-[.8rem] font-semibold text-[var(--text-secondary)]">${E(T('wiki.fieldTitle'))}</span>
          <input id="w-title" class="${INPUT} mt-1" maxlength="200" value="${E(base?.title || '')}"></label>
        <label class="block"><span class="text-[.8rem] font-semibold text-[var(--text-secondary)]">${E(T('wiki.fieldSummary'))}</span>
          <span class="block text-[.72rem] text-[var(--text-muted)]">${E(T('wiki.fieldSummaryHint'))}</span>
          <textarea id="w-summary" rows="2" class="${INPUT} mt-1">${E(base?.summary || '')}</textarea></label>
        <label class="block"><span class="text-[.8rem] font-semibold text-[var(--text-secondary)]">${E(T('wiki.fieldDocType'))}</span>
          <select id="w-doctype" class="${INPUT} mt-1" ${alter ? 'disabled' : ''}>
            <option value="">${E(T('wiki.chooseType'))}</option>
            ${DOC_TYPES.map((d) => `<option value="${d}" ${base?.doc_type === d ? 'selected' : ''}>${E(T(`wiki.docType.${d}`))}: ${E(T(`wiki.docTypeHint.${d}`))}</option>`).join('')}
          </select></label>
        <fieldset class="space-y-2"><legend class="text-[.8rem] font-semibold text-[var(--text-secondary)]">${E(T('wiki.sources'))}</legend>
          <p class="text-[.72rem] text-[var(--text-muted)]">${E(T(alter ? 'wiki.alterKeepsMeta' : 'wiki.sourcesHint'))}</p>
          <div id="w-sources" class="space-y-2">${sources.map((s) => sourceRow(s, alter)).join('')}</div>
          ${alter ? '' : `<button type="button" id="w-src-add" class="${BTN_SECONDARY} !py-1 !text-xs">+ ${E(T('wiki.addSource'))}</button>`}
        </fieldset>
        <div>
          <div class="flex items-center justify-between">
            <span class="text-[.8rem] font-semibold text-[var(--text-secondary)]">${E(T('wiki.fieldContent'))}</span>
            <button type="button" id="w-preview-toggle" class="${BTN_SECONDARY} !py-1 !text-xs">${E(T('wiki.preview'))}</button>
          </div>
          <textarea id="w-content" rows="18" class="${INPUT} mt-1 font-mono !text-[.8rem]">${E(base?.content || '')}</textarea>
          <div id="w-preview" class="hidden mt-1 rounded-lg border border-[var(--border-default)] p-4 prose prose-sm max-w-none text-[var(--text-primary)]"></div>
        </div>
        ${alter ? `<label class="block"><span class="text-[.8rem] font-semibold text-[var(--text-secondary)]">${E(T('wiki.reasonAlter'))}</span>
          <textarea id="w-alter-reason" rows="2" class="${INPUT} mt-1"></textarea></label>` : ''}
        <div class="flex flex-wrap gap-2">
          ${alter
            ? `<button type="button" id="w-save-alter" class="${BTN_PRIMARY}">${E(T('wiki.publishAlteration'))}</button>`
            : `<button type="button" id="w-save" class="${BTN_SECONDARY}">${E(T('wiki.saveDraft'))}</button>
               <button type="button" id="w-save-submit" class="${BTN_PRIMARY}">${E(T('wiki.saveAndSubmit'))}</button>`}
        </div>
        <p class="text-[.72rem] text-[var(--text-muted)]">${E(T(alter ? 'wiki.alterHint' : 'wiki.flowHint'))}</p>
      </form>`;

    const $ = <El extends HTMLElement>(id: string) => document.getElementById(id) as El;
    const srcBox = $('w-sources');
    srcBox.addEventListener('click', (ev) => {
      const del = (ev.target as HTMLElement).closest('.w-src-del');
      if (del) del.closest('.w-source')?.remove();
    });
    $('w-src-add')?.addEventListener('click', () => srcBox.insertAdjacentHTML('beforeend', sourceRow()));
    $('w-preview-toggle').addEventListener('click', () => {
      const pv = $('w-preview'); const ta = $<HTMLTextAreaElement>('w-content');
      const showing = !pv.classList.contains('hidden');
      if (!showing) pv.innerHTML = renderMd(ta.value, path || prefix) || `<p class="text-[var(--text-muted)]">${E(T('wiki.previewEmpty'))}</p>`;
      pv.classList.toggle('hidden', showing); ta.classList.toggle('hidden', !showing);
      $('w-preview-toggle').textContent = T(showing ? 'wiki.preview' : 'wiki.write');
    });

    function collect() {
      const title = $<HTMLInputElement>('w-title').value.trim();
      if (!title) throw new Error(T('wiki.titleRequired'));
      let finalPath = path;
      if (!finalPath) {
        const slug = slugify($<HTMLInputElement>('w-slug').value);
        finalPath = slug ? `${prefix}/${slug}` : prefix;
        if (pages.some((p) => p.path === finalPath)) throw new Error(T('wiki.pathTaken'));
      }
      const srcs = [...srcBox.querySelectorAll('.w-source')].map((row) => ({
        label: (row.querySelector('.w-src-label') as HTMLInputElement).value.trim(),
        url: (row.querySelector('.w-src-url') as HTMLInputElement).value.trim(),
      })).filter((s) => s.label || s.url);
      for (const s of srcs) if (s.url && !safeNavigationUrl(s.url)) throw new Error(T('wiki.badSourceUrl', { url: s.url }));
      return {
        path: finalPath as string, title,
        summary: $<HTMLTextAreaElement>('w-summary').value.trim(),
        docType: $<HTMLSelectElement>('w-doctype').value || null,
        sources: srcs.map((s) => (s.url ? s : { label: s.label })),
        content: $<HTMLTextAreaElement>('w-content').value,
      };
    }

    async function save(andSubmit: boolean) {
      const f = collect();
      const vid = await rpc('wiki_save_draft', {
        p_page_path: f.path, p_initiative_id: tribe!.id, p_title: f.title, p_summary: f.summary,
        p_content: f.content, p_doc_type: f.docType, p_sources: f.sources, p_domain: tribe!.domain,
        p_version_id: o.mode === 'edit' ? o.id : null,
      });
      if (andSubmit) {
        const r = await rpc('wiki_submit', { p_version_id: vid });
        toast(T(r?.route === 'committee' ? 'wiki.submittedCommittee' : 'wiki.submittedLeader'));
      } else {
        toast(T('wiki.draftSaved'));
      }
      // replace, e não href: o Voltar do navegador não pode reabrir este editor já preenchido, senão o próximo
      // "salvar" abre outra versão da mesma página (29/09/2026, duas lideranças).
      location.replace(href({ version: vid }));
    }

    const bind = (btnId: string, fn: () => Promise<void>) => {
      const b = document.getElementById(btnId) as HTMLButtonElement | null;
      b?.addEventListener('click', async () => {
        b.disabled = true;
        try { await fn(); } catch (e) { toast(errMsg(e), 'error'); b.disabled = false; }
      });
    };
    bind('w-save', () => save(false));
    bind('w-save-submit', () => save(true));
    bind('w-save-alter', async () => {
      const f = collect();
      const reason = $<HTMLTextAreaElement>('w-alter-reason').value.trim();
      if (!reason) throw new Error(T('wiki.reasonRequired'));
      const nid = await rpc('wiki_audit', {
        p_version_id: o.id, p_outcome: 'altered', p_reason: reason,
        p_title: f.title, p_summary: f.summary, p_content: f.content,
      });
      toast(T('wiki.alteredToast'));
      location.href = href({ version: nid });
    });
  }

  // ── sugestões de melhoria ──────────────────────────────────────────────────────────────────────
  const SUGG_CLASS: Record<string, string> = {
    open: 'bg-amber-100 text-amber-800',
    accepted: 'bg-emerald-100 text-emerald-800',
    declined: 'bg-slate-100 text-slate-600',
  };
  const suggChip = (s: string) => chip(T(`wiki.suggestStatus.${s}`), own(SUGG_CLASS, s) || 'bg-slate-100 text-slate-700');

  async function refreshSuggestions() {
    const d = await rpc('wiki_suggestion_queue');
    sugg = { to_decide: d?.to_decide || [], mine: d?.mine || [] };
    renderTabs();
  }

  function suggestionList(items: any[], meta: (x: any) => string[], extra: (x: any) => string, empty: string): string {
    if (!items.length) return `<div class="${CARD}">${emptyBox(empty)}</div>`;
    return `<ul class="${CARD} !py-1">${items.map((x) => `
      <li class="py-3 border-b border-[var(--border-subtle)] last:border-0" data-sugg="${E(x.id)}">
        <a href="${E(href({ page: x.page_path }))}" class="font-semibold text-[var(--text-primary)] no-underline hover:underline">${E(x.page_title)}</a>
        <div class="text-[.72rem] text-[var(--text-muted)] mt-0.5 flex flex-wrap items-center gap-1.5">${meta(x).filter(Boolean).join('')}</div>
        <p class="text-sm text-[var(--text-primary)] mt-1.5 whitespace-pre-wrap">${E(x.body)}</p>
        ${extra(x)}
      </li>`).join('')}</ul>`;
  }

  // ── abas de trabalho ───────────────────────────────────────────────────────────────────────────
  function workList(items: any[], line: (x: any) => string, empty: string): string {
    if (!items.length) return `<div class="${CARD}">${emptyBox(empty)}</div>`;
    return `<ul class="${CARD} !py-1">${items.map((x) => `
      <li class="py-2.5 border-b border-[var(--border-subtle)] last:border-0">
        <a href="${E(href({ version: x.id }))}" class="font-semibold text-[var(--text-primary)] no-underline hover:underline">${E(x.title)}</a>
        <div class="text-[.72rem] text-[var(--text-muted)] mt-0.5 flex flex-wrap items-center gap-1.5">${line(x)}</div>
      </li>`).join('')}</ul>`;
  }

  function viewMine() {
    const tribeOptions = ctx.initiatives.map((t) => `<option value="${E(t.id)}">${E(t.title)}${t.status === 'active' ? '' : ` (${E(T('wiki.archived'))})`}</option>`).join('');
    const newForm = ctx.initiatives.length ? `
      <div class="${CARD} !p-4 flex flex-wrap items-end gap-2">
        <label class="flex-1 min-w-[220px]"><span class="text-[.8rem] font-semibold text-[var(--text-secondary)]">${E(T('wiki.newPageIn'))}</span>
          <select id="w-new-tribe" class="${INPUT} mt-1">${tribeOptions}</select></label>
        <button type="button" id="w-new-go" class="${BTN_PRIMARY}">${E(T('wiki.newPage'))}</button>
      </div>` : `<div class="${CARD}">${emptyBox(T('wiki.noTribes'))}</div>`;
    view().innerHTML = `<div class="space-y-4 max-w-4xl">
      ${myTribesCallout()}
      ${newForm}
      <h2 class="text-sm font-bold text-[var(--text-primary)]">${E(T('wiki.myOpenVersions'))}</h2>
      ${workList(queue.my_versions, (x) => `${statusChip(x.status)}<code>${E(x.page_path)}</code><span>${E(fmtDate(x.updated_at))}</span>`, T('wiki.noOpenVersions'))}
      <h2 class="text-sm font-bold text-[var(--text-primary)] pt-2">${E(T('wiki.mySuggestions'))}</h2>
      ${suggestionList(sugg.mine,
        (x) => [suggChip(x.status), `<span>${E(fmtDate(x.created_at))}</span>`,
          x.decided_at ? `<span>${E(T('wiki.suggestAnsweredOn', { date: fmtDate(x.decided_at) }))}</span>` : ''],
        (x) => x.decision_reason
          ? `<p class="text-[.78rem] text-[var(--text-secondary)] mt-1"><strong>${E(T('wiki.suggestReasonLabel'))}</strong> ${E(x.decision_reason)}</p>` : '',
        T('wiki.noMySuggestions'))}
    </div>`;
    document.getElementById('w-new-go')?.addEventListener('click', () => {
      const id = (document.getElementById('w-new-tribe') as HTMLSelectElement).value;
      location.href = href({ new: id });
    });
  }

  function viewDecide() {
    view().innerHTML = `<div class="space-y-3 max-w-4xl">
      <p class="text-[.8rem] text-[var(--text-secondary)]">${E(T('wiki.decideIntro'))}</p>
      ${workList(queue.awaiting_my_decision, (x) => `${statusChip(x.status)}<span>${E(x.initiative)}</span><span>${E(T('wiki.submittedOn', { date: fmtDate(x.submitted_at) }))}</span>${x.pii ? chip(T('wiki.piiShort'), 'bg-red-100 text-red-700') : ''}`, T('wiki.nothingToDecide'))}
      <h2 class="text-sm font-bold text-[var(--text-primary)] pt-2">${E(T('wiki.suggestionsToDecide'))}</h2>
      <p class="text-[.8rem] text-[var(--text-secondary)]">${E(T('wiki.suggestionsIntro'))}</p>
      ${suggestionList(sugg.to_decide,
        (x) => [`<span>${E(x.initiative || T('wiki.suggestRouteCommittee'))}</span>`,
          x.author ? `<span>${E(T('wiki.suggestedBy', { name: x.author }))}</span>` : '',
          `<span>${E(fmtDate(x.created_at))}</span>`, x.pii ? chip(T('wiki.piiShort'), 'bg-red-100 text-red-700') : ''],
        () => `<div class="mt-2 space-y-2">
          <textarea rows="2" maxlength="1000" class="${INPUT}" data-reason placeholder="${E(T('wiki.suggestReason'))}"></textarea>
          <div class="flex gap-2">
            <button type="button" class="${BTN_PRIMARY} !py-1 !px-3 !text-xs" data-decide="accepted">${E(T('wiki.suggestAccept'))}</button>
            <button type="button" class="${BTN_SECONDARY} !py-1 !px-3 !text-xs" data-decide="declined">${E(T('wiki.suggestDecline'))}</button>
          </div></div>`,
        T('wiki.noSuggestionsToDecide'))}
    </div>`;
    view().querySelectorAll('[data-decide]').forEach((b) => b.addEventListener('click', async () => {
      const li = (b as HTMLElement).closest('[data-sugg]') as HTMLElement;
      const decision = (b as HTMLElement).dataset.decide!;
      const reason = (li.querySelector('[data-reason]') as HTMLTextAreaElement).value.trim();
      // Recusar exige motivo: quem sugeriu recebe a resposta, e nenhuma sugestão se resolve em silêncio.
      if (decision === 'declined' && !reason) { toast(T('wiki.suggestReasonRequired'), 'error'); return; }
      const buttons = li.querySelectorAll('button') as NodeListOf<HTMLButtonElement>;
      buttons.forEach((x) => (x.disabled = true));
      try {
        await rpc('wiki_suggestion_decide', { p_suggestion_id: li.dataset.sugg, p_decision: decision, p_reason: reason || null });
        toast(T(decision === 'accepted' ? 'wiki.suggestAcceptedToast' : 'wiki.suggestDeclinedToast'));
        await refreshSuggestions();
        viewDecide();
      } catch (e) {
        toast(errMsg(e) || T('wiki.loadError'), 'error');
        buttons.forEach((x) => (x.disabled = false));
      }
    }));
  }

  function viewAudit() {
    view().innerHTML = `<div class="space-y-3 max-w-4xl">
      <p class="text-[.8rem] text-[var(--text-secondary)]">${E(T('wiki.auditIntro'))}</p>
      ${workList(queue.audit_pending, (x) => `<span>${E(x.initiative)}</span><span>${E(T('wiki.publishedOn', { date: fmtDate(x.published_at) }))}</span>${x.overdue ? chip(T('wiki.overdue'), 'bg-red-100 text-red-700') : `<span>${E(T('wiki.dueOn', { date: fmtDate(x.audit_due_at) }))}</span>`}`, T('wiki.nothingToAudit'))}
    </div>`;
  }

  // ── rota e arranque ────────────────────────────────────────────────────────────────────────────
  async function route() {
    const isHome = !['version', 'page', 'edit', 'alter', 'new', 'q', 'type', 'tab'].some((k) => params.get(k));
    document.getElementById('wiki-bar')?.classList.toggle('hidden', isHome);
    if (!isHome) { renderTabs(); mountSearch(document.querySelector('[data-search="mini"]') as HTMLElement, false, params.get('q') || ''); }
    view().innerHTML = `<p class="text-sm text-[var(--text-muted)] py-6 text-center">${E(T('wiki.loading'))}</p>`;
    try {
      const tab = params.get('tab');
      if (params.get('version')) return await viewVersion(params.get('version')!);
      if (params.get('page')) return await viewPage(params.get('page')!);
      if (params.get('edit')) return await viewEditor({ mode: 'edit', id: params.get('edit')! });
      if (params.get('alter')) return await viewEditor({ mode: 'alter', id: params.get('alter')! });
      if (params.get('new')) return await viewEditor({ mode: 'new', initiative: params.get('new')!, path: params.get('path') });
      if (tab === 'mine') return viewMine();
      if (tab === 'decide') return viewDecide();
      if (tab === 'audit' && ctx.is_committee) return viewAudit();
      const q = (params.get('q') || '').trim();
      const typ = DOC_TYPES.includes(params.get('type') || '') ? params.get('type')! : '';
      if (q || typ) return await viewResults(q, typ);
      return viewHome();
    } catch (e) {
      view().innerHTML = errorBox(errMsg(e) || T('wiki.loadError'));
    }
  }

  // Quem não entrou vê o que é o wiki e o botão de entrar; membro inativo vê só a explicação.
  function deny(msg: string, canLogin: boolean) {
    document.getElementById('wiki-loading')?.classList.add('hidden');
    (document.getElementById('wiki-gate-msg') as HTMLElement).textContent = msg;
    const login = document.getElementById('wiki-gate-login') as HTMLButtonElement | null;
    if (login) {
      login.classList.toggle('hidden', !canLogin);
      login.onclick = () => (document.getElementById('nav-login-btn') as HTMLElement | null)?.click();
    }
    document.getElementById('wiki-gate')?.classList.remove('hidden');
  }

  let started = false;
  async function start() {
    if (started) return;
    started = true;
    const [c, q, p, o, s] = await Promise.all([
      sb.rpc('wiki_authoring_context'),
      sb.rpc('wiki_review_queue'),
      sb.from('wiki_pages').select('path,title,summary,domain,tags,source_repo,audit_status,updated_at,authors,platform_version_id').order('title'),
      sb.rpc('wiki_initiatives_overview'),
      sb.rpc('wiki_suggestion_queue'),
    ]);
    const err = c.error || q.error || p.error || o.error || s.error;
    if (err) { deny(/requer membro ativo/.test(err.message || '') ? T('wiki.activeOnly') : T('wiki.loadError'), false); return; }
    ctx = { is_committee: !!c.data?.is_committee, initiatives: c.data?.initiatives || [] };
    queue = {
      awaiting_my_decision: q.data?.awaiting_my_decision || [],
      audit_pending: q.data?.audit_pending || [],
      my_versions: q.data?.my_versions || [],
    };
    pages = p.data || [];
    overview = o.data || [];
    sugg = { to_decide: s.data?.to_decide || [], mine: s.data?.mine || [] };
    document.getElementById('wiki-loading')?.classList.add('hidden');
    document.getElementById('wiki-gate')?.classList.add('hidden');
    document.getElementById('wiki-app')?.classList.remove('hidden');
    (document.getElementById('wiki-home') as HTMLAnchorElement).href = href();
    await route();
  }

  async function boot() {
    sb = (window as any).navGetSb?.();
    if (!sb) { setTimeout(boot, 200); return; }
    if ((window as any).navGetMember?.()) { start(); return; }
    window.addEventListener('nav:member', ((e: CustomEvent) => { if (e.detail) start(); }) as EventListener);
    try {
      const { data: { session } } = await sb.auth.getSession();
      if (session) { start(); return; }
    } catch { /* sem sessão */ }
    deny(T('wiki.loginRequired'), true);
  }

  // Página restaurada do cache do navegador (Voltar/Avançar) traz o estado velho, inclusive um editor já preenchido:
  // recarrega para montar a tela com as filas de agora.
  window.addEventListener('pageshow', (e) => { if ((e as PageTransitionEvent).persisted) location.reload(); });

  boot();
</script>
