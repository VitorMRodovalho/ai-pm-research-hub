---
/**
 * /podcast — episódios do podcast do Núcleo (#2553).
 *
 * SSR, como o /blog: a lista sai no HTML para busca e para prévia de link. A fonte é
 * get_public_podcast_episodes (comms_media_items, canal spotify, ingerido do RSS público pela EF
 * sync-comms-metrics); nenhuma lista de episódios vive aqui. O filtro por série é só apresentação e
 * guarda o estado na URL (?serie=).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { t, getLangFromURL, type Lang } from '../i18n/utils';
import { createClient } from '@supabase/supabase-js';

const lang: Lang = getLangFromURL(Astro.url.pathname + Astro.url.search);
const locale = lang === 'en-US' ? 'en-US' : lang === 'es-LATAM' ? 'es-ES' : 'pt-BR';

const sb = createClient(
  import.meta.env.PUBLIC_SUPABASE_URL,
  import.meta.env.PUBLIC_SUPABASE_ANON_KEY
);

type Episode = {
  id: string;
  title: string;
  series: string | null;
  published_at: string;
  duration_seconds: number | null;
  cover_url: string | null;
  audio_url: string | null;
  audio_type: string | null;
};

const { data, error } = await sb.rpc('get_public_podcast_episodes', { p_limit: 100 });
if (error) console.error('[podcast] get_public_podcast_episodes:', error.message);
const episodes: Episode[] = (data as any)?.episodes ?? [];
const showUrl: string | null = (data as any)?.show_url ?? null;

const series = [...new Set(episodes.map((e) => e.series).filter((s): s is string => !!s))];

function fmtDuration(s: number | null): string {
  if (!s || s <= 0) return '';
  const m = Math.floor(s / 60);
  const r = String(s % 60).padStart(2, '0');
  return `${m}:${r}`;
}

const pageTitle = t('podcast.meta.title', lang);
const pageDesc = t('podcast.meta.description', lang);
---

<BaseLayout title={pageTitle} description={pageDesc} activePage="podcast" lang={lang}>
  <meta slot="head" property="og:title" content={pageTitle} />
  <meta slot="head" property="og:description" content={pageDesc} />
  <meta slot="head" property="og:type" content="website" />

  <div class="max-w-[900px] mx-auto px-4 py-12">
    <p class="text-xs font-semibold uppercase tracking-wider text-[var(--fg-muted)] mb-2">{t('podcast.kicker', lang)}</p>
    <h1 class="text-3xl font-bold text-[var(--fg)] mb-2">{t('podcast.title', lang)}</h1>
    <p class="text-[var(--fg-muted)] mb-6">{t('podcast.subtitle', lang)}</p>

    <div class="flex flex-wrap items-center gap-3 mb-8">
      {showUrl && (
        <a href={showUrl} target="_blank" rel="noopener noreferrer"
           class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-[#1DB954] text-black text-sm font-semibold no-underline hover:opacity-90">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"/></svg>
          {t('podcast.followSpotify', lang)}
        </a>
      )}
      {lang !== 'pt-BR' && (
        <span class="text-xs px-2 py-1 rounded bg-[var(--surface-section-cool)] text-[var(--text-secondary)]">{t('podcast.langNotice', lang)}</span>
      )}
    </div>

    {series.length > 1 && (
      <div class="flex flex-wrap gap-2 mb-6" role="group" aria-label={t('podcast.filterLabel', lang)} id="podcast-filters">
        <button type="button" data-serie="" aria-pressed="true"
                class="podcast-chip px-3 py-1 rounded-full text-xs font-medium border border-[var(--border)]">{t('podcast.filterAll', lang)}</button>
        {series.map((s) => (
          <button type="button" data-serie={s} aria-pressed="false"
                  class="podcast-chip px-3 py-1 rounded-full text-xs font-medium border border-[var(--border)]">{s}</button>
        ))}
      </div>
    )}

    {episodes.length === 0 ? (
      <div class="text-center py-16 text-[var(--fg-muted)]">
        <p class="mb-4">{t('podcast.empty', lang)}</p>
        {showUrl && <a href={showUrl} target="_blank" rel="noopener noreferrer" class="text-teal-400 underline">{t('podcast.followSpotify', lang)}</a>}
      </div>
    ) : (
      <ol class="space-y-4 list-none p-0" id="podcast-list">
        {episodes.map((e) => {
          const date = e.published_at
            ? new Date(e.published_at).toLocaleDateString(locale, { year: 'numeric', month: 'long', day: 'numeric' })
            : '';
          const dur = fmtDuration(e.duration_seconds);
          return (
            <li class="podcast-ep bg-[var(--surface)] border border-[var(--border)] rounded-xl p-4 flex gap-4" data-serie={e.series ?? ''}>
              {e.cover_url && (
                <img src={e.cover_url} alt="" width="88" height="88" loading="lazy" decoding="async"
                     class="w-[88px] h-[88px] rounded-lg object-cover flex-shrink-0" />
              )}
              <div class="min-w-0 flex-1">
                {e.series && (
                  <span class="inline-block px-2 py-0.5 rounded text-[11px] font-semibold mb-1"
                        style="background:var(--status-info-bg);color:var(--status-info-text)">{e.series}</span>
                )}
                <h2 class="text-base font-bold text-[var(--fg)] mb-1 leading-snug">{e.title}</h2>
                <p class="text-xs text-[var(--fg-muted)] mb-3">
                  <time datetime={e.published_at}>{date}</time>{dur && <span> · {dur}</span>}
                </p>
                {e.audio_url && (
                  <audio controls preload="none" class="w-full max-w-[520px]">
                    <source src={e.audio_url} type={e.audio_type ?? undefined} />
                    <a href={e.audio_url}>{t('podcast.audioFallback', lang)}</a>
                  </audio>
                )}
              </div>
            </li>
          );
        })}
      </ol>
    )}
  </div>
</BaseLayout>

<style>
  .podcast-chip { background: transparent; color: var(--fg-muted); cursor: pointer; }
  .podcast-chip[aria-pressed='true'] { background: var(--fg); color: var(--surface); border-color: var(--fg); }
</style>

<script>
  // Filtro por série: só apresentação. O estado fica em ?serie= para o link compartilhado abrir filtrado.
  (function () {
    const group = document.getElementById('podcast-filters');
    if (!group) return;
    const chips = Array.from(group.querySelectorAll<HTMLButtonElement>('.podcast-chip'));
    const eps = Array.from(document.querySelectorAll<HTMLElement>('.podcast-ep'));

    function apply(serie: string) {
      const known = chips.some((c) => c.dataset.serie === serie);
      const active = known ? serie : '';
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.serie === active)));
      eps.forEach((el) => { el.hidden = !!active && el.dataset.serie !== active; });
      const url = new URL(window.location.href);
      if (active) url.searchParams.set('serie', active); else url.searchParams.delete('serie');
      history.replaceState(null, '', url);
    }

    chips.forEach((c) => c.addEventListener('click', () => apply(c.dataset.serie ?? '')));
    apply(new URL(window.location.href).searchParams.get('serie') ?? '');
  })();
</script>
