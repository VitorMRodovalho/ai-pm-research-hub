---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t, getLangFromURL, type Lang } from '../i18n/utils';
import ImpactPageIsland, { type LineNames } from '../components/islands/ImpactPageIsland';
import { SEO_CANONICAL_ORIGIN } from '../lib/canonical';
import { loadHomeStats } from '../lib/homeStats';
import { loadResearchLines, loadImpactData } from '../lib/publicHomeData';

const lang: Lang = getLangFromURL(Astro.url.pathname + Astro.url.search);
const langPrefix = lang === 'pt-BR' ? '' : lang === 'en-US' ? '/en' : '/es';

const pageTitle = t('about.meta.title', lang);
const pageDesc = t('about.meta.description', lang);
// PR4 A6 (GP 25/10/2026): os dados do /about saem do servidor, como os da home, e o HTML já leva números, capítulos,
// linhas, história e publicações. A leitura começa aqui e corre junto com as duas de baixo; falhou, vem null, e a
// página busca no navegador como antes (nunca 500).
const impactRead = loadImpactData().catch(() => null);
// #2553 D7: o número de pesquisadores sai da fonte única da home (era 51 escrito); sem número, o campo some.
const researchers = (await loadHomeStats())?.members ?? null;
// #2783: nome e quadrante das linhas na língua da página, pela mesma fonte da lista de linhas da home.
const lineNames: LineNames = Object.fromEntries(
  ((await loadResearchLines(lang)) ?? []).map((line) => [line.id, { name: line.name, quadrantName: line.quadrantName }]),
);
// #2783: textos que já existem nos dicionários; a descrição institucional é a da home, palavra por palavra.
const text = {
  relation: t('homeV2.hero.relation', lang),
  privacy: t('nav.privacy', lang),
  memberOne: t('about.memberCountOne', lang),
};
const impact = await impactRead;
---

<BaseLayout title={pageTitle} description={pageDesc} activePage="about" lang={lang} alternates="query">
  <meta slot="head" property="og:title" content={pageTitle} />
  <meta slot="head" property="og:description" content={pageDesc} />
  <meta slot="head" property="og:type" content="website" />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "ResearchOrganization",
    // PR3 A5 (GP 25/10/2026): em inglês, o nome curto; português e espanhol seguem com o nome de sempre
    "name": lang === 'en-US' ? 'AI & PM Research Hub' : "Núcleo de Estudos e Pesquisa em IA & Gerenciamento de Projetos",
    "description": pageDesc,
    "url": SEO_CANONICAL_ORIGIN,
    // #2553 D11: iniciativa de capítulos, sediada no PMI Goiás; "Não é um programa do PMI, Inc."
    "parentOrganization": { "@type": "Organization", "name": "PMI Goiás" },
    ...(researchers !== null ? { "numberOfEmployees": { "@type": "QuantitativeValue", "value": researchers } } : {})
  })} />

  <div class="max-w-[1100px] mx-auto px-4 py-8">
    <ImpactPageIsland client:load lang={lang} lineNames={lineNames} text={text} initialData={impact} />
  </div>
</BaseLayout>
