---
import BaseLayout from '../layouts/BaseLayout.astro';
import Toast from '../components/ui/Toast.astro';
import OnboardingCockpitNudge from '../components/onboarding/OnboardingCockpitNudge';
import MapConsentNudge from '../components/onboarding/MapConsentNudge';
import HomepageHero from '../components/sections/HomepageHero.astro';
import OutputsSection from '../components/sections/OutputsSection.astro';
import ResearchLinesSection from '../components/sections/ResearchLinesSection.astro';
import JoinSection from '../components/sections/JoinSection.astro';
import TeamSummarySection from '../components/sections/TeamSummarySection.astro';
import FollowSection from '../components/sections/FollowSection.astro';
import LegacyHomeAnchors from '../components/sections/LegacyHomeAnchors.astro';
import { loadHomeStats } from '../lib/homeStats';
import KpiSection from '../components/sections/KpiSection.astro';
import WeeklyScheduleSection from '../components/sections/WeeklyScheduleSection.astro';
import LadderSection from '../components/sections/LadderSection.astro';
import ChaptersSection from '../components/sections/ChaptersSection.astro';
import { t, getLangFromURL, type Lang } from '../i18n/utils';
import { buildPageI18n } from '../i18n/pageI18n';
import PresentationLayer from '../components/ui/PresentationLayer.astro';

const lang: Lang = getLangFromURL(Astro.url.pathname + Astro.url.search);
// #2553: uma busca só dos números da home, passada aos blocos que os mostram.
const homeStats = await loadHomeStats();
// R8: localizes the public AgendaVivaPublic island in the reframed agenda section.
const i18nBundle = buildPageI18n(['comp.agendaViva'], lang);
---
<BaseLayout title={t('meta.title', lang)} activePage="home" lang={lang}>
  <script id="page-i18n" type="application/json" set:html={i18nBundle}></script>
  <Toast />
  <OnboardingCockpitNudge client:load lang={lang} />
  <MapConsentNudge client:load lang={lang}
    consentText={t('profile.allowPreciseLocationMapLabel', lang)}
    title={t('mapConsent.title', lang)} accept={t('mapConsent.accept', lang)} later={t('mapConsent.later', lang)}
    legacyNote={t('mapConsent.legacyNote', lang)} done={t('mapConsent.done', lang)} error={t('mapConsent.error', lang)} />
  {/* #2553 PR 2 (home v2): a ordem da maquete aprovada pelo GP em 19 e 20/10/2026. Hero → produção → linhas →
       capítulos → portas → agenda → quem faz → escada e mural → metas → acompanhe. As seções de membro saíram da
       home (ranking, regras, recursos, mosaico, braços); as âncoras antigas levam ao destino novo (script abaixo). */}
  <HomepageHero lang={lang} stats={homeStats} />
  <OutputsSection lang={lang} />
  <ResearchLinesSection lang={lang} />
  <ChaptersSection lang={lang} stats={homeStats} />
  <JoinSection lang={lang} />
  <WeeklyScheduleSection lang={lang} />
  <TeamSummarySection lang={lang} stats={homeStats} />
  <LadderSection lang={lang} />
  <KpiSection lang={lang} />
  <FollowSection lang={lang} />
  <LegacyHomeAnchors lang={lang} />
  <PresentationLayer context="home" lang={lang} />
</BaseLayout>
