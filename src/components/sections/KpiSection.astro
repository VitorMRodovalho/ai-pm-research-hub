---
/**
 * #2553 PR 2 (D9, GP 20/10/2026): as metas pactuadas do ano, todas, com atual e alvo lidos no servidor de
 * exec_portfolio_health. Antes o alvo vinha de src/data/kpis.ts (texto fixo) e só a barra vinha do banco, no
 * navegador; um alvo de 8 capítulos convivia com 15 no ar.
 *
 * Meta acima do alvo aparece como "superada", igual ao alvo como "atingida", e abaixo dele com a barra real.
 * Nenhuma meta sai da tela. Sem leitura, o bloco diz que as metas estão indisponíveis, sem número de reserva.
 */
import { t, type Lang } from '../../i18n/utils';
import { loadHomeGoals, goalState, currentYearBrt, type HomeGoal } from '../../lib/publicHomeData';

interface Props { lang?: Lang; }
const { lang = 'pt-BR' } = Astro.props;

const goals = await loadHomeGoals(lang);
const locale = lang === 'pt-BR' ? 'pt-BR' : lang === 'en-US' ? 'en-US' : 'es';
const nf = new Intl.NumberFormat(locale, { maximumFractionDigits: 0 });
const withUnit = (g: HomeGoal, v: number) =>
  g.unit === 'percent' ? `${nf.format(v)}%` : g.unit === 'hours' ? `${nf.format(v)} h` : nf.format(v);
const stateLabel = { surpassed: t('kpis.surpassed', lang), met: t('kpis.met', lang), behind: '', unavailable: '' };
---

<section class="py-16 px-6 bg-[var(--surface-card)]" id="kpis">
  <div class="max-w-[1200px] mx-auto">
    <div class="text-[.73rem] font-bold tracking-[.15em] uppercase text-teal mb-2">
      {t('kpis.label', lang)}
    </div>
    <h2 class="text-[clamp(1.7rem,4vw,2.5rem)] font-extrabold leading-tight mb-3 text-navy">
      {t('kpis.title', lang).replace('{year}', currentYearBrt())}
    </h2>
    <p class="text-base text-[var(--text-secondary)] max-w-[700px] mb-8">
      {t('kpis.subtitle', lang)}
    </p>

    {goals ? (
      <ul class="list-none m-0 p-0 grid gap-4 max-w-[760px]" id="kpi-list">
        {goals.map((g) => {
          const state = goalState(g);
          const pct = g.current !== null && g.target !== null ? Math.min(100, Math.round((g.current / g.target) * 100)) : 0;
          const text = g.current !== null && g.target !== null
            ? t('kpis.ofTarget', lang).replace('{current}', withUnit(g, g.current)).replace('{target}', withUnit(g, g.target))
            : t('kpis.goalUnavailable', lang);
          return (
            <li class="grid gap-1.5" data-kpi={g.key} data-state={state}>
              <div class="flex justify-between gap-3 text-[.95rem]">
                <span>{g.label}</span>
                <b class="tabular-nums text-right">{text}{stateLabel[state] && <span class="text-emerald-700 dark:text-emerald-400"> · {stateLabel[state]}</span>}</b>
              </div>
              <div class="h-2.5 rounded-full bg-[var(--surface-section-cool)] overflow-hidden" role="img" aria-label={`${g.label}: ${text}`}>
                {state !== 'unavailable' && <div class={`h-full rounded-full ${state === 'behind' ? 'bg-teal' : 'bg-emerald-600'}`} style={`width:${pct}%`}></div>}
              </div>
            </li>
          );
        })}
      </ul>
    ) : (
      <p class="text-sm text-[var(--text-secondary)]" id="kpi-unavailable">{t('kpis.unavailable', lang)}</p>
    )}
  </div>
</section>
