---
import { t, type Lang } from '../../i18n/utils';
import { createClient } from '@supabase/supabase-js';
import type { HomeStats } from '../../lib/homeStats';
import { currentYearBrt } from '../../lib/publicHomeData';
import { youtubeEmbedUrl, youtubeWatchUrl } from '../../data/youtube-playlists';

interface Props { lang?: Lang; stats?: HomeStats | null; }
const { lang = 'pt-BR', stats = null } = Astro.props;

// #2553 PR 3: o vídeo do hero. O id mora no SSOT; o endereço do player só vira iframe no clique (script abaixo).
const heroVideoEmbed = youtubeEmbedUrl('homeHero', lang);
const heroVideoWatch = youtubeWatchUrl('homeHero');
const heroVideoSizes = '(min-width: 1280px) 460px, (min-width: 640px) 600px, 100vw';
const heroCapaAvif = '/assets/home/hero-video-capa-960.avif 960w, /assets/home/hero-video-capa-1600.avif 1600w';
const heroCapaWebp = '/assets/home/hero-video-capa-960.webp 960w, /assets/home/hero-video-capa-1600.webp 1600w';
// GIF transparente de 1x1: o <img> nasce sem pedir a capa, que só vem quando a figura entra na tela (script abaixo).
const heroCapaVazia = 'data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==';

// #2553: os 4 números do hero (pesquisadores, linhas, capítulos, horas) vêm da busca única da página
// (loadHomeStats), a mesma que alimenta a seção de capítulos.
const langPrefix = lang === 'pt-BR' ? '' : lang === 'en-US' ? '/en' : '/es';
// #2553: o número final já sai no HTML; a contagem é só enfeite, e só para quem não pediu menos movimento.
const statText = (n: number | null | undefined, suffix = '') => (typeof n === 'number' ? `${n}${suffix}` : '--');

// #1239: derive the hero cycle badge + status from the CURRENT cycle (was hardcoded 'CICLO 3 · 2026').
// Mirrors ChaptersSection's anon RPC fetch; get_current_cycle is anon-EXECUTE granted.
let cycleNum = '';
let cycleYear = '';
try {
  const sbAnon = createClient(import.meta.env.PUBLIC_SUPABASE_URL, import.meta.env.PUBLIC_SUPABASE_ANON_KEY);
  const { data } = await sbAnon.rpc('get_current_cycle');
  if (data) {
    cycleNum = String((data as any).cycle_abbr ?? '').replace(/\D/g, '');
    cycleYear = String((data as any).cycle_start ?? '').slice(0, 4);
  }
} catch { /* fall back to neutral i18n strings below */ }

const heroBadge = cycleNum
  ? t('hero.badge', lang).replace('{n}', cycleNum).replace('{year}', cycleYear)
  : t('hero.badgeFallback', lang);
---

<section class="hero relative min-h-screen flex items-center justify-center overflow-hidden pt-14" id="hero">
  <div class="absolute -top-1/2 -right-[30%] w-[80vw] h-[80vw] rounded-full bg-[radial-gradient(circle,rgba(5,191,224,.08)_0%,transparent_60%)] pointer-events-none"></div>
  <div class="absolute -bottom-[20%] -left-[20%] w-[60vw] h-[60vw] rounded-full bg-[radial-gradient(circle,rgba(255,97,15,.06)_0%,transparent_50%)] pointer-events-none"></div>

  <!-- ═══ VISITOR HERO ═══ -->
  <!-- #2553 PR 2: título, frase do problema e relação com o PMI (D11, versão A), 4 números da fonte única e duas
       portas: pesquisar, ou capítulos e organizações. "Entrar" fica no menu.
       #2553 PR 3: o vídeo entra ao lado do texto no desktop e embaixo dos botões no celular (D3 do GP, 31/10). O lado a
       lado começa em 1280 px: medido em 1024, o título quebrava em 4 linhas e os rótulos dos números em 3. -->
  <!-- A grade fica num filho: no próprio #hero-visitor, o xl:grid venceria o `hidden` que o script põe para membro. -->
  <div id="hero-visitor" class="relative z-10 w-full max-w-[1200px] px-6 py-8">
  <div class="xl:grid xl:grid-cols-[minmax(0,1fr)_460px] xl:gap-12 xl:items-center">
   <div class="text-center xl:text-left">
    <div class="inline-block bg-orange/15 text-orange text-[.78rem] font-semibold px-5 py-1.5 rounded-full border border-orange/30 mb-6 tracking-wider uppercase">
      {heroBadge}
    </div>

    <h1 class="text-[clamp(2rem,5vw,3.25rem)] font-extrabold text-white leading-[1.12] mb-5">
      {t('homeV2.hero.title', lang)}
    </h1>

    <p class="text-[clamp(.95rem,2.2vw,1.15rem)] text-white/75 max-w-[680px] mx-auto xl:mx-0 mb-3">
      {t('homeV2.hero.problem', lang)}
    </p>
    <p id="hero-pmi-relation" class="text-[clamp(.85rem,2vw,1rem)] text-white/60 max-w-[680px] mx-auto xl:mx-0 mb-8">
      {t('homeV2.hero.relation', lang)}
    </p>

    <!-- Stats counters -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-6 sm:gap-10 xl:gap-6 mb-8 max-w-[760px] mx-auto xl:mx-0">
      <div class="text-center">
        <div class="text-3xl sm:text-4xl font-extrabold text-[#05BFE0] tabular-nums" id="stat-members" data-target={stats?.members ?? undefined}>{statText(stats?.members)}</div>
        <div class="text-[.7rem] text-white/60 uppercase tracking-wider mt-1">{t('homeV2.hero.statResearchers', lang)}</div>
      </div>
      <div class="text-center">
        <div class="text-3xl sm:text-4xl font-extrabold text-[#05BFE0] tabular-nums" id="stat-tribes" data-target={stats?.tribes ?? undefined}>{statText(stats?.tribes)}</div>
        <div class="text-[.7rem] text-white/60 uppercase tracking-wider mt-1">{t('homeV2.hero.statLines', lang)}</div>
      </div>
      <div class="text-center">
        <div class="text-3xl sm:text-4xl font-extrabold text-[#05BFE0] tabular-nums" id="stat-chapters" data-target={stats?.chapters ?? undefined}>{statText(stats?.chapters)}</div>
        <div class="text-[.7rem] text-white/60 uppercase tracking-wider mt-1">{t('homeV2.hero.statChapters', lang)}</div>
      </div>
      <div class="text-center">
        <div class="text-3xl sm:text-4xl font-extrabold text-[#05BFE0] tabular-nums" id="stat-hours" data-target={stats?.impactHours ?? undefined} data-suffix="h">{statText(stats?.impactHours, 'h')}</div>
        <div class="text-[.7rem] text-white/60 uppercase tracking-wider mt-1">{t('homeV2.hero.statHours', lang).replace('{year}', currentYearBrt())}</div>
      </div>
    </div>

    <!-- CTAs -->
    <div class="flex flex-wrap justify-center xl:justify-start gap-3">
      <a href="#join" class="inline-flex items-center min-h-[44px] px-6 py-3 bg-[var(--color-orange-deep)] text-white rounded-xl text-[.95rem] font-bold no-underline hover:opacity-90">
        {t('homeV2.hero.ctaResearch', lang)}
      </a>
      <a href="#join-institutions" class="inline-flex items-center min-h-[44px] px-6 py-3 bg-white/10 border border-white/30 text-white rounded-xl text-[.95rem] font-semibold no-underline hover:bg-white/15">
        {t('homeV2.hero.ctaInstitutions', lang)}
      </a>
    </div>
   </div>

    <!-- #2553 PR 3: o vídeo. Até o clique, a página só tem a capa servida daqui; nenhum pedido sai para o YouTube.
         A capa só é pedida quando a figura entra na tela (decisão de 31/10): no celular ela fica logo abaixo da
         primeira tela, e o lazy nativo a pedia já na carga. Sem JavaScript, vale a cópia em <noscript>. -->
    <figure id="hero-video" class="mt-10 xl:mt-0 mx-auto w-full max-w-[600px] xl:max-w-none" data-embed-src={heroVideoEmbed} data-title={t('homeV2.hero.videoTitle', lang)}>
      <button type="button" id="hero-video-play" class="group relative block w-full aspect-video overflow-hidden rounded-2xl border border-white/15 bg-white/5 p-0 cursor-pointer shadow-[0_20px_60px_rgba(0,0,0,.35)]" aria-label={t('homeV2.hero.videoPlay', lang)}>
        <picture id="hero-video-capa">
          <source type="image/avif" data-srcset={heroCapaAvif} sizes={heroVideoSizes} />
          <source type="image/webp" data-srcset={heroCapaWebp} sizes={heroVideoSizes} />
          <img src={heroCapaVazia} data-src="/assets/home/hero-video-capa-960.webp" width="960" height="540" alt="" decoding="async" fetchpriority="low" class="block w-full h-full object-cover" />
        </picture>
        <noscript>
          <picture>
            <source type="image/avif" srcset={heroCapaAvif} sizes={heroVideoSizes} />
            <source type="image/webp" srcset={heroCapaWebp} sizes={heroVideoSizes} />
            <img src="/assets/home/hero-video-capa-960.webp" width="960" height="540" alt="" loading="lazy" decoding="async" class="absolute inset-0 block w-full h-full object-cover" />
          </picture>
        </noscript>
        <span class="absolute inset-0 flex items-center justify-center bg-black/10 group-hover:bg-black/0 transition-colors" aria-hidden="true">
          <span class="flex items-center justify-center w-16 h-16 rounded-full bg-[var(--color-orange-deep)] text-white shadow-lg">
            <svg viewBox="0 0 24 24" class="w-7 h-7 ml-1" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
          </span>
        </span>
      </button>
      <figcaption class="mt-3 text-[.8rem] text-white/65 text-center xl:text-left">
        {t('homeV2.hero.videoMeta', lang)}{' · '}<a href={heroVideoWatch} target="_blank" rel="noopener noreferrer" class="text-white/80 underline underline-offset-2 hover:text-white">{t('homeV2.hero.videoOpenYoutube', lang)}</a>
      </figcaption>
    </figure>
  </div>
  </div>

  <!-- ═══ MEMBER HERO ═══ -->
  <div id="hero-member" class="hidden relative z-10 w-full max-w-[900px] px-6 py-8">
    <h2 class="text-[clamp(1.5rem,4vw,2.5rem)] font-extrabold text-white mb-6 text-center">
      {t('hero.member.greeting', lang)} <span id="hero-name" class="text-[#05BFE0]">...</span>
    </h2>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 max-w-[700px] mx-auto">
      <!-- Next General Meeting -->
      <div class="bg-white/8 border border-white/10 rounded-2xl p-5">
        <div class="text-[.75rem] font-bold text-white/50 uppercase tracking-wider mb-2">{t('hero.member.nextMeeting', lang)}</div>
        <div id="hero-general-date" class="text-lg font-bold text-[#05BFE0]">...</div>
        <div id="hero-general-time" class="text-sm text-white/60 mt-0.5">19:00 BRT</div>
        <a id="hero-general-link" href="#" target="_blank" rel="noopener"
          class="hidden mt-3 inline-flex items-center gap-1.5 px-4 py-2 bg-[#05BFE0] text-navy rounded-lg text-[.8rem] font-bold no-underline hover:opacity-90 transition-all">
          {t('hero.joinMeet', lang)} →
        </a>
        <a id="hero-general-youtube" href="#" target="_blank" rel="noopener"
          class="hidden mt-2 ml-2 inline-flex items-center gap-1.5 px-4 py-2 bg-red-600 text-white rounded-lg text-[.8rem] font-bold no-underline hover:opacity-90 transition-all">
          🎥 {t('hero.watchYoutube', lang)} →
        </a>
      </div>

      <!-- Tribe Info -->
      <div class="bg-white/8 border border-white/10 rounded-2xl p-5">
        <div class="text-[.75rem] font-bold text-white/50 uppercase tracking-wider mb-2">{t('hero.member.yourTribe', lang)}</div>
        <div id="hero-tribe-info">
          <div class="text-sm text-white/40">{t('common.loading', lang)}</div>
        </div>
      </div>

      <!-- Attendance Mini -->
      <div class="bg-white/8 border border-white/10 rounded-2xl p-5">
        <div class="text-[.75rem] font-bold text-white/50 uppercase tracking-wider mb-2">{t('hero.member.attendance', lang)}</div>
        <div id="hero-att-info">
          <div class="text-sm text-white/40">{t('common.loading', lang)}</div>
        </div>
      </div>

      <!-- Quick Actions -->
      <div class="bg-white/8 border border-white/10 rounded-2xl p-5">
        <div class="text-[.75rem] font-bold text-white/50 uppercase tracking-wider mb-2">{t('hero.member.quickActions', lang)}</div>
        <div class="space-y-2">
          <a href={`${langPrefix}/attendance`} class="block px-3 py-2 rounded-lg bg-white/10 text-white text-xs font-semibold hover:bg-white/20 no-underline transition-colors">{t('hero.member.createEvent', lang)}</a>
          <a href={`${langPrefix}/attendance`} class="block px-3 py-2 rounded-lg bg-white/10 text-white text-xs font-semibold hover:bg-white/20 no-underline transition-colors">{t('hero.member.registerAttendance', lang)}</a>
          <a href={`${langPrefix}/gamification`} class="block px-3 py-2 rounded-lg bg-white/10 text-white text-xs font-semibold hover:bg-white/20 no-underline transition-colors">{t('hero.member.viewRanking', lang)}</a>
          <a href={`${langPrefix}/docs/mcp/conectar`} class="block px-3 py-2 rounded-lg bg-[#05BFE0]/15 border border-[#05BFE0]/30 text-[#05BFE0] text-xs font-semibold hover:bg-[#05BFE0]/25 no-underline transition-colors">{t('hero.member.connectMcp', lang)}</a>
        </div>
      </div>
    </div>

    <!-- Dropout risk (GP only) -->
    <div id="hero-dropout-alert" class="hidden mt-4 text-center">
      <span class="inline-flex items-center gap-2 text-sm font-semibold text-amber-400 bg-amber-900/20 border border-amber-500/30 px-4 py-2 rounded-xl"></span>
    </div>

    <!-- Cycle badge -->
    <div class="text-center mt-5">
      <div class="inline-flex items-center gap-2 text-[.82rem] text-white/60">
        <span class="w-2 h-2 rounded-full bg-green-400" aria-hidden="true"></span>
        {t('hero.cycleActive', lang)}
      </div>
    </div>
  </div>

</section>

<!-- i18n data for client-side JS -->
<span id="hero-i18n-today" class="hidden">{t('hero.member.today', lang)}</span>
<span id="hero-i18n-noMeetings" class="hidden">{t('hero.member.noMeetings', lang)}</span>
<span id="hero-i18n-joinMeet" class="hidden">{t('hero.joinMeet', lang)}</span>
<span id="hero-i18n-watchYoutube" class="hidden">{t('hero.watchYoutube', lang)}</span>
<span id="hero-i18n-noTribe" class="hidden">{t('hero.member.noTribe', lang)}</span>
<span id="hero-i18n-goWorkspace" class="hidden">{t('hero.member.goWorkspace', lang)}</span>
<span id="hero-i18n-noData" class="hidden">{t('hero.member.noData', lang)}</span>
<span id="hero-i18n-general" class="hidden">{t('hero.member.generalLabel', lang)}</span>
<span id="hero-i18n-tribe" class="hidden">{t('hero.member.tribeLabel', lang)}</span>
<span id="hero-i18n-combined" class="hidden">{t('hero.member.combinedLabel', lang)}</span>
<span id="hero-i18n-dropout" class="hidden">{t('hero.member.dropoutRisk', lang)}</span>
<span id="hero-i18n-locale" class="hidden">{t('hero.dateLocale', lang)}</span>
<span id="hero-lang-prefix" class="hidden" data-prefix={langPrefix}></span>

<script is:inline define:vars={{ langPrefix }}>
  if (typeof window !== 'undefined' && !window.__LANG_PREFIX) window.__LANG_PREFIX = langPrefix;
</script>

<script>
  // #2553 PR 3: o player do YouTube só passa a existir no clique. O endereço (domínio sem cookies, legenda pela língua
  // da página) vem pronto do servidor em data-embed-src; aqui só se troca o botão pelo iframe.
  const heroVideo = document.getElementById('hero-video');
  const heroVideoPlay = document.getElementById('hero-video-play');
  // A capa só é pedida quando a figura entra na tela, sem margem. Quem não rola não paga a capa.
  const heroVideoCapa = document.getElementById('hero-video-capa');
  if (heroVideoCapa) {
    const carregarCapa = () => {
      heroVideoCapa.querySelectorAll<HTMLSourceElement>('source[data-srcset]').forEach((s) => { s.srcset = s.dataset.srcset ?? ''; });
      const img = heroVideoCapa.querySelector<HTMLImageElement>('img[data-src]');
      if (img) img.src = img.dataset.src ?? '';
    };
    const observador = new IntersectionObserver((entradas) => {
      if (entradas.some((e) => e.isIntersecting)) { observador.disconnect(); carregarCapa(); }
    }, { rootMargin: '0px' });
    observador.observe(heroVideoCapa);
  }
  if (heroVideo && heroVideoPlay) {
    heroVideoPlay.addEventListener('click', () => {
      const frame = document.createElement('iframe');
      frame.src = heroVideo.dataset.embedSrc ?? '';
      frame.title = heroVideo.dataset.title ?? '';
      frame.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      frame.allowFullscreen = true;
      frame.referrerPolicy = 'strict-origin-when-cross-origin';
      frame.className = 'block w-full aspect-video rounded-2xl border border-white/15';
      heroVideoPlay.replaceWith(frame);
      frame.focus();
    }, { once: true });
  }
</script>

<script>
  import { hasPermission } from '../../lib/permissions';
  (async () => {
    // Read i18n from hidden spans
    const _locale = document.getElementById('hero-i18n-locale')?.textContent || 'pt-BR';
    const i18nToday = document.getElementById('hero-i18n-today')?.textContent || 'Hoje';
    const i18nNoMeetings = document.getElementById('hero-i18n-noMeetings')?.textContent || 'Sem reuniões próximas';
    const i18nJoinMeet = document.getElementById('hero-i18n-joinMeet')?.textContent || 'Entrar no Meet';
    const i18nNoTribe = document.getElementById('hero-i18n-noTribe')?.textContent || 'Sem tribo atribuída';
    const i18nGoWorkspace = document.getElementById('hero-i18n-goWorkspace')?.textContent || 'Acesse o Workspace →';
    const i18nNoData = document.getElementById('hero-i18n-noData')?.textContent || 'Sem dados ainda';
    const i18nGeneral = document.getElementById('hero-i18n-general')?.textContent || 'Geral';
    const i18nTribe = document.getElementById('hero-i18n-tribe')?.textContent || 'Tribo';
    const i18nCombined = document.getElementById('hero-i18n-combined')?.textContent || 'Combinado';
    const i18nDropout = document.getElementById('hero-i18n-dropout')?.textContent || 'membro(s) em risco de dropout';

    // Wait for supabase
    function waitSb(): Promise<any> {
      return new Promise(resolve => {
        const sb = (window as any).navGetSb?.();
        if (sb) return resolve(sb);
        const interval = setInterval(() => {
          const s = (window as any).navGetSb?.();
          if (s) { clearInterval(interval); resolve(s); }
        }, 200);
      });
    }

    // ── Homepage stats ──
    // #2553: os valores chegam no HTML (data-target e o texto final), da busca única da página. Uma
    // segunda chamada aqui seria outra fonte para os mesmos números. Sem data-target, fica o "--".
    // A contagem só roda para quem não pediu menos movimento; para os outros o número já está lá.
    const motionOk = window.matchMedia('(prefers-reduced-motion: no-preference)').matches;
    for (const id of ['stat-members', 'stat-tribes', 'stat-chapters', 'stat-hours']) {
      const el = document.getElementById(id);
      const target = Number(el?.dataset.target);
      if (motionOk && el?.dataset.target !== undefined && Number.isFinite(target)) {
        animateCounter(id, target, el.dataset.suffix ?? '');
      }
    }

    const sb = await waitSb();

    // ── Auth detection ──
    function onMember(member: any) {
      const visitorEl = document.getElementById('hero-visitor');
      const memberEl = document.getElementById('hero-member');
      if (!visitorEl || !memberEl) return;

      visitorEl.classList.add('hidden');
      memberEl.classList.remove('hidden');

      // Name
      const nameEl = document.getElementById('hero-name');
      if (nameEl) nameEl.textContent = (member.name || '').split(' ')[0] || member.name || 'Membro';

      // Next general meeting — from real events in DB
      const dateEl = document.getElementById('hero-general-date');
      const timeEl = document.getElementById('hero-general-time');
      const linkEl = document.getElementById('hero-general-link') as HTMLAnchorElement;
      const ytEl = document.getElementById('hero-general-youtube') as HTMLAnchorElement;

      sb.from('events')
        .select('id, title, date, time_start, meeting_link, recording_url, youtube_url, duration_minutes')
        .eq('type', 'geral')
        .gte('date', new Date(Date.now() - 14 * 86400000).toISOString().slice(0,10))
        .order('date', { ascending: true })
        .limit(10)
        .then(({ data: evts }: any) => {
          var now = new Date();
          var todayStr = now.toISOString().slice(0,10);
          var ev = (evts || []).find(function(e: any) {
            if (e.date > todayStr) return true;
            if (e.date === todayStr) {
              var stp = (e.time_start || '19:00:00').split(':');
              var endMinutes = (+stp[0]) * 60 + (+stp[1]) + (e.duration_minutes || 60);
              var nowMinutes = now.getHours() * 60 + now.getMinutes();
              return nowMinutes < endMinutes;
            }
            return false;
          });
          if (ev && dateEl) {
            const evDate = new Date(ev.date + 'T' + (ev.time_start || '19:00:00'));
            const isToday = ev.date === new Date().toISOString().slice(0,10);
            dateEl.textContent = isToday
              ? `${i18nToday} 🔴`
              : evDate.toLocaleDateString(_locale, { weekday: 'long', day: '2-digit', month: 'short' });
            if (timeEl) timeEl.textContent = (ev.time_start ? ev.time_start.slice(0, 5) : '19:00') + ' BRT';
            if (ev.meeting_link && linkEl) {
              linkEl.href = ev.meeting_link;
              linkEl.classList.remove('hidden');
            }
            if (isToday && ev.youtube_url && ytEl) {
              ytEl.href = ev.youtube_url;
              ytEl.classList.remove('hidden');
            }
            if (!isToday) {
              const lastWithRecording = (evts || []).reverse().find(function(e: any) {
                return e.date < todayStr && (e.youtube_url || e.recording_url);
              });
              if (lastWithRecording) {
                const recUrl = lastWithRecording.youtube_url || lastWithRecording.recording_url;
                const recDate = new Date(lastWithRecording.date + 'T12:00:00');
                const recLabel = recDate.toLocaleDateString(_locale, { day: '2-digit', month: 'short' });
                if (timeEl) timeEl.innerHTML = `${ev.time_start ? ev.time_start.slice(0, 5) : '19:00'} BRT · <a href="${recUrl}" target="_blank" rel="noopener" class="text-red-400 hover:text-red-300 no-underline font-semibold">🎥 ${recLabel}</a>`;
              }
            }
          } else if (dateEl) {
            dateEl.textContent = i18nNoMeetings;
            if (timeEl) timeEl.textContent = '';
          }
        });

      // Tribe info
      if (member.tribe_id) {
        Promise.all([
          sb.from('tribes').select('name, name_i18n, meeting_link').eq('id', member.tribe_id).single(),
          sb.from('tribe_meeting_slots').select('day_of_week, time_start, time_end')
            .eq('tribe_id', member.tribe_id).eq('is_active', true),
        ]).then(([tribeRes, slotRes]: [any, any]) => {
          const tribe = tribeRes.data;
          const slots = slotRes.data || [];
          const infoEl = document.getElementById('hero-tribe-info');
          if (!infoEl) return;

          const _sl = _locale.startsWith('en') ? 'en' : _locale.startsWith('es') ? 'es' : 'pt';
          const _tribeName = tribe?.name_i18n?.[_sl] || tribe?.name || '...';
          let html = `<div class="text-lg font-bold text-[#05BFE0]">T${member.tribe_id}: ${escHtml(_tribeName)}</div>`;
          if (slots.length) {
            const dayNames = _locale.startsWith('en') ? ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'] : _locale.startsWith('es') ? ['Dom','Lun','Mar','Mié','Jue','Vie','Sáb'] : ['Dom','Seg','Ter','Qua','Qui','Sex','Sáb'];
            const slotLabels = slots.map((s: any) => {
              const start = (s.time_start || '').substring(0,5).replace(/:00$/, 'h').replace(/:(\d\d)$/, 'h$1');
              const end = (s.time_end || '').substring(0,5).replace(/:00$/, 'h').replace(/:(\d\d)$/, 'h$1');
              return `${dayNames[s.day_of_week]} · ${start}–${end}`;
            }).join(' · ');
            html += `<div class="text-sm text-white/60 mt-1">${slotLabels}</div>`;
          }
          if (tribe?.meeting_link) {
            html += `<a href="${escHtml(tribe.meeting_link)}" target="_blank" rel="noopener"
              class="mt-3 inline-flex items-center gap-1.5 px-4 py-2 bg-[#05BFE0] text-navy rounded-lg text-[.8rem] font-bold no-underline hover:opacity-90 transition-all">
              ${i18nJoinMeet} →</a>`;
          }
          infoEl.innerHTML = html;
        });
      } else {
        const infoEl = document.getElementById('hero-tribe-info');
        if (infoEl) {
          const lp = (typeof window !== 'undefined' && (window as any).__LANG_PREFIX) || '';
          infoEl.innerHTML = `<div class="text-sm text-white/50">${i18nNoTribe}</div>
            <a href="${lp}/workspace" class="mt-2 text-[.8rem] text-[#05BFE0] font-semibold no-underline hover:underline">${i18nGoWorkspace}</a>`;
        }
      }

      // Attendance
      sb.rpc('get_attendance_panel').then(({ data }: any) => {
        const attEl = document.getElementById('hero-att-info');
        if (!attEl || !data) { if (attEl) attEl.innerHTML = `<div class="text-sm text-white/50">${i18nNoData}</div>`; return; }
        const myRow = data.find((r: any) => r.member_id === member.id);
        if (!myRow) { attEl.innerHTML = `<div class="text-sm text-white/50">${i18nNoData}</div>`; return; }
        const gPct = myRow.general_pct || 0;
        const tPct = myRow.tribe_pct || 0;
        const tribeEvents = myRow.tribe_mandatory ?? 0;
        const tribeDisplay = tribeEvents > 0 ? `${tPct}%` : '—';
        const combined = myRow.combined_pct || 0;
        const color = combined >= 75 ? '#10B981' : combined >= 50 ? '#F59E0B' : '#EF4444';
        attEl.innerHTML = `
          <div class="text-sm text-white/60">${i18nGeneral}: <b class="text-white">${gPct}%</b> · ${i18nTribe}: <b class="text-white">${tribeDisplay}</b></div>
          <div class="text-xl font-extrabold mt-1" style="color:${color}">${i18nCombined}: ${combined}%</div>`;
      }).catch(() => {});

      // Dropout risk (GP only)
      const isGP = hasPermission(member, 'admin.access');
      if (isGP) {
        sb.rpc('get_dropout_risk_members', { p_threshold: 3 }).then(({ data }: any) => {
          if (data?.length > 0) {
            const alertEl = document.getElementById('hero-dropout-alert');
            if (alertEl) {
              alertEl.classList.remove('hidden');
              const span = alertEl.querySelector('span');
              if (span) span.textContent = `⚠️ ${data.length} ${i18nDropout}`;
            }
          }
        }).catch(() => {});
      }
    }

    // Check if already logged in
    const m = (window as any).navGetMember?.();
    if (m) { onMember(m); }
    window.addEventListener('nav:member', ((e: CustomEvent) => {
      if (e.detail) onMember(e.detail);
    }) as EventListener);


    // ── Helpers ──
    function animateCounter(id: string, target: number, suffix = '') {
      const el = document.getElementById(id);
      if (!el) return;
      const duration = 1200;
      const start = performance.now();
      function step(now: number) {
        const progress = Math.min((now - start) / duration, 1);
        const eased = 1 - Math.pow(1 - progress, 3);
        el!.textContent = Math.round(target * eased) + suffix;
        if (progress < 1) requestAnimationFrame(step);
      }
      const observer = new IntersectionObserver(entries => {
        if (entries[0].isIntersecting) {
          observer.disconnect();
          requestAnimationFrame(step);
        }
      }, { threshold: 0.3 });
      observer.observe(el);
    }

    function escHtml(s: string): string {
      const d = document.createElement('div');
      d.textContent = s;
      return d.innerHTML;
    }
  })();
</script>

