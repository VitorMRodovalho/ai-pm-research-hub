---
// R8 (R-AGENDA-HOME) — reframed from a login-walled weekly schedule into a public
// event-landing surface. The old static "next General Meeting" card (which showed a
// loginHint to anon — the login wall the diagnosis flagged) is replaced by the
// anon-safe AgendaVivaPublic island: it reads get_geral_agenda_viva (SECURITY DEFINER,
// layered PII) and renders the REAL next General Meetings with their reservable
// protagonism blocks. Below it, the tribe weekly cadence stays as public reference info.
import { t, type Lang } from '../../i18n/utils';
import AgendaVivaPublic from '../agenda/AgendaVivaPublic.tsx';
import { buildPageI18n } from '../../i18n/pageI18n';
import { resolveTribes } from '../../data/tribes';

interface Props { lang?: Lang; }
const { lang = 'pt-BR' } = Astro.props;
const langPrefix = lang === 'pt-BR' ? '' : lang === 'en-US' ? '/en' : '/es';
const agendaLabels: Record<string, string> = JSON.parse(buildPageI18n(['comp.agendaViva'], lang));
// #2738: o nome vem da mesma fonte dos cards de Research Streams; a tabela tribes não é legível pelo anônimo.
const tribeNames: Record<number, string> = Object.fromEntries(resolveTribes(lang).map((tr) => [tr.id, tr.name]));
---

<section class="py-16 px-6 bg-[var(--surface-section-warm)]" id="agenda">
  <div class="max-w-[900px] mx-auto">
    <div class="text-[.73rem] font-bold tracking-[.15em] uppercase text-orange mb-2">
      {t('schedule.label', lang)}
    </div>
    <h2 class="text-[clamp(1.5rem,3.5vw,2.2rem)] font-extrabold text-[var(--text-primary)] leading-tight mb-3">
      {t('schedule.publicTitle', lang)}
    </h2>
    <p class="text-base text-[var(--text-secondary)] max-w-[640px] mb-8">
      {t('schedule.publicSubtitle', lang)}
    </p>

    <!-- Public protagonism agenda (anon-safe). Replaces the login-walled general-meeting card.
         #812: range="both" surfaces the last concluded meeting + the next ones (past→future
         columns-by-date timeline), the "pós-evento" state the PM asked for. -->
    <AgendaVivaPublic client:visible lang={lang} range="both" labels={agendaLabels} />

    <!-- Funnel CTA tie-in: 4th touch of the repeated primary "Seja protagonista" → #join -->
    <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-3">
      <a href="#join"
        class="inline-flex items-center gap-2 px-5 py-2.5 bg-orange text-white rounded-xl text-[.9rem] font-bold no-underline hover:opacity-90 transition-all">
        {t('router.protagonist.cta', lang)} →
      </a>
      <a href={`${langPrefix}/reunioes-gerais`}
        class="inline-flex items-center gap-1.5 text-[.85rem] font-bold text-orange no-underline hover:underline">
        ⭐ {t('comp.agendaViva.homeCta', lang)} →
      </a>
    </div>

    <!-- Tribe Meetings by Day (public reference cadence — no login wall) -->
    <h3 class="text-sm font-bold text-[var(--text-secondary)] mt-12 mb-3 uppercase tracking-wider">
      {t('schedule.tribeMeetings', lang)}
    </h3>
    <div id="schedule-tribe-grid" class="space-y-2">
      <div class="text-sm text-[var(--text-muted)] py-4 text-center">{t('common.loading', lang)}</div>
    </div>
  </div>
</section>

<span id="schedule-i18n-yourTribe" class="hidden">{t('schedule.yourTribe', lang)}</span>
<span id="schedule-i18n-noMeetings" class="hidden">{t('schedule.noMeetings', lang)}</span>
<script id="schedule-tribe-names" type="application/json" set:html={JSON.stringify(tribeNames)}></script>

<script>
  (() => {
    const _locale = location.pathname.startsWith('/en') ? 'en' : location.pathname.startsWith('/es') ? 'es' : 'pt';
    const DAY_NAMES_MAP: Record<string, string[]> = {
      pt: ['Dom', 'Seg', 'Ter', 'Qua', 'Qui', 'Sex', 'Sáb'],
      en: ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'],
      es: ['Dom', 'Lun', 'Mar', 'Mié', 'Jue', 'Vie', 'Sáb'],
    };
    const DAY_NAMES = DAY_NAMES_MAP[_locale] || DAY_NAMES_MAP.pt;
    const DAY_ORDER = [1, 2, 3, 4, 5, 6, 0];
    const i18nYourTribe = document.getElementById('schedule-i18n-yourTribe')?.textContent || 'sua tribo';
    const i18nNoMeetings = document.getElementById('schedule-i18n-noMeetings')?.textContent || 'Nenhuma reunião agendada.';
    let tribeNames: Record<string, string> = {};
    try { tribeNames = JSON.parse(document.getElementById('schedule-tribe-names')?.textContent || '{}'); } catch {}

    async function loadSchedule() {
      const sb = (window as any).navGetSb?.();
      if (!sb) { setTimeout(loadSchedule, 300); return; }

      try {
        // #2738: horários pela mesma RPC pública dos cards (tribo ativa e visível, slot ativo). Ler
        // `tribes` direto devolvia 0 linhas ao anônimo, e a grade dizia que não havia reunião.
        // `tribes` segue lida só pelo meeting_link, que é de membro.
        const [{ data: profiles }, { data: tribes }] = await Promise.all([
          sb.rpc('get_tribe_public_profiles'),
          sb.from('tribes').select('id, meeting_link').eq('is_active', true),
        ]);

        if (!Array.isArray(profiles)) return;

        const linkById = new Map<number, string | null>((tribes || []).map((t: any) => [t.id, t.meeting_link]));

        const byDay = new Map<number, any[]>();
        for (const p of profiles) {
          const tribeId = Number(p.tribe_id);
          for (const slot of (p.slots || [])) {
            if (!byDay.has(slot.day_of_week)) byDay.set(slot.day_of_week, []);
            byDay.get(slot.day_of_week)!.push({ ...slot, tribe_id: tribeId, tribe_name: tribeNames[String(tribeId)] || `T${tribeId}`, meeting_link: linkById.get(tribeId) });
          }
        }
        for (const entries of byDay.values()) entries.sort((a: any, b: any) => String(a.time_start).localeCompare(String(b.time_start)));

        const member = (window as any).navGetMember?.();
        const myTribeId = member?.tribe_id;
        const isAuth = !!member;

        const grid = document.getElementById('schedule-tribe-grid');
        if (!grid) return;

        let html = '';
        for (const day of DAY_ORDER) {
          const entries = byDay.get(day);
          if (!entries?.length) continue;

          html += `<div class="bg-[var(--surface-card)] border border-[var(--border-subtle)] rounded-xl px-4 py-3">
            <div class="text-[.72rem] font-bold text-[var(--text-muted)] uppercase tracking-wider mb-2">${DAY_NAMES[day]}</div>
            <div class="flex flex-wrap gap-x-4 gap-y-2">`;

          for (const entry of entries) {
            const isMine = myTribeId === entry.tribe_id;
            const highlight = isMine ? 'font-bold text-teal' : 'text-[var(--text-primary)]';
            const badge = isMine ? ` <span class="text-[.6rem] font-bold px-1.5 py-0.5 rounded-full bg-teal/10 text-teal">${i18nYourTribe}</span>` : '';

            if (isAuth && entry.meeting_link) {
              html += `<a href="${escHtml(entry.meeting_link)}" target="_blank" rel="noopener"
                class="text-[.82rem] ${highlight} no-underline hover:underline">
                T${entry.tribe_id}: ${escHtml(entry.tribe_name)} (${entry.time_start})${badge}
              </a>`;
            } else {
              html += `<span class="text-[.82rem] ${highlight}">
                T${entry.tribe_id}: ${escHtml(entry.tribe_name)} (${entry.time_start})${badge}
              </span>`;
            }
          }

          html += '</div></div>';
        }

        grid.innerHTML = html || `<div class="text-sm text-[var(--text-muted)] text-center py-4">${i18nNoMeetings}</div>`;
      } catch (e) { console.warn('schedule load:', e); }
    }

    loadSchedule();
    window.addEventListener('nav:member', () => loadSchedule());

    function escHtml(s: string): string {
      const d = document.createElement('div');
      d.textContent = s;
      return d.innerHTML;
    }
  })();
</script>
