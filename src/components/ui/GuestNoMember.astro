---
/**
 * Bloco para quem ENTROU (tem sessão) e não tem cadastro de membro (#3086, #3106).
 *
 * Quem cai aqui ou foi aprovado e entrou com outro e-mail (vínculo em /claim/start) ou nunca se
 * candidatou (entrada pela seleção, seção #join da home). Pedir login a essa pessoa não resolve
 * nada, porque ela já entrou. Nasce escondido; a página mostra quando o Nav resolve a sessão sem
 * membro (onMemberResolved → kind 'no-member').
 */
import { t, type Lang } from '../../i18n/utils';

interface Props { lang: Lang; id: string }
const { lang, id } = Astro.props;
const langPrefix = lang === 'pt-BR' ? '' : lang === 'en-US' ? '/en' : '/es';
---
<div id={id} class="hidden" data-guest-no-member>
  <div class="bg-[var(--surface-card)] rounded-2xl border border-[var(--border-default)] p-8 text-center">
    <div class="text-4xl mb-3">🔒</div>
    <h2 class="text-lg font-bold text-navy mb-2">{t('guest.notRegistered', lang)}</h2>
    <p class="text-[var(--text-secondary)] text-sm mb-4">{t('guest.contactAdmin', lang)}</p>
    <div class="flex flex-wrap justify-center gap-3">
      <a id={`${id}-apply`} href={`${langPrefix}/#join`}
         class="inline-block px-5 py-2.5 bg-navy text-white rounded-xl font-semibold text-sm no-underline hover:opacity-90 transition-all">
        {t('guest.applyCta', lang)}
      </a>
      <a id={`${id}-claim`} href={`${langPrefix}/claim/start`}
         class="inline-block px-5 py-2.5 border border-[var(--border-default)] text-[var(--text-primary)] rounded-xl font-semibold text-sm no-underline hover:bg-[var(--surface-hover)] transition-all">
        {t('guest.claimCta', lang)}
      </a>
    </div>
    <p class="text-xs text-[var(--text-muted)] mt-4">{t('guest.questions', lang)} <a href={`mailto:${t('guest.contactEmail', lang)}`} class="underline">{t('guest.contactEmail', lang)}</a></p>
  </div>
</div>
