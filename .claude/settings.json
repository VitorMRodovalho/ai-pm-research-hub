{
  "deniedMcpServers": [
    {
      "serverName": "claude_ai_PostHog"
    },
    {
      "serverName": "ms365"
    },
    {
      "serverName": "claude_ai_Canva"
    },
    {
      "serverName": "claude_ai_Notion"
    },
    {
      "serverName": "claude_ai_Figma"
    },
    {
      "serverName": "claude_ai_Sentry"
    },
    {
      "serverName": "claude_ai_Miro"
    },
    {
      "serverName": "claude_ai_Scholar_Gateway"
    },
    {
      "serverName": "claude_ai_Gmail"
    },
    {
      "serverName": "claude_ai_Google_Calendar"
    },
    {
      "serverName": "claude_ai_Microsoft_Learn"
    }
  ],
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(supabase *)",
      "Bash(curl *)",
      "Bash(wc *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(diff *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(sed *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(echo *)",
      "Bash(source *)",
      "Bash(timeout *)",
      "Bash(sleep *)",
      "Bash(du *)",
      "Bash(dig *)",
      "Bash(host *)",
      "Bash(python3 *)",
      "Bash(node *)",
      "Bash(chmod *)",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Agent"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Edit(.env)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~/*)",
      "Bash(rm -rf $HOME*)",
      "Bash(rm -rf /home/*)",
      "Bash(rm -rf /usr/*)",
      "Bash(rm -rf /etc/*)",
      "Bash(rm -rf /var/*)",
      "Bash(rm -rf /boot/*)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease*)",
      "Bash(git reset --hard*)",
      "Bash(git checkout --*)",
      "Bash(git clean -f*)",
      "Bash(git clean -d*)",
      "Bash(git branch -D*)",
      "Bash(git update-ref -d *)",
      "Bash(git filter-branch*)",
      "Bash(git filter-repo*)",
      "Bash(sudo dd *)",
      "Bash(dd if=*)",
      "Bash(mkfs*)",
      "Bash(curl * | sh*)",
      "Bash(curl * | bash*)",
      "Bash(wget * | sh*)",
      "Bash(wget * | bash*)",
      "Bash(npm publish*)",
      "Bash(pnpm publish*)",
      "Bash(yarn publish*)",
      "Bash(pip uninstall*)",
      "Bash(pnpm remove*)",
      "Bash(chmod -R 777 *)",
      "Bash(chown -R *)",
      "Edit(.git/*)"
    ]
  },
  "hooks": {
    "PostCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/post-compact.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__claude_ai_Supabase__apply_migration|mcp__supabase__apply_migration|mcp__claude_ai_Supabase__execute_sql|mcp__supabase__execute_sql|mcp__claude_ai_Supabase__deploy_edge_function|mcp__supabase__deploy_edge_function|mcp__claude_ai_Supabase__create_branch|mcp__supabase__create_branch|mcp__claude_ai_Supabase__delete_branch|mcp__supabase__delete_branch|mcp__claude_ai_Supabase__merge_branch|mcp__supabase__merge_branch|mcp__claude_ai_Supabase__reset_branch|mcp__supabase__reset_branch|mcp__claude_ai_Supabase__rebase_branch|mcp__supabase__rebase_branch|mcp__claude_ai_Supabase__pause_project|mcp__supabase__pause_project|mcp__claude_ai_Supabase__restore_project|mcp__supabase__restore_project",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/db-write-gate.py\"",
            "timeout": 25,
            "statusMessage": "Conferindo quem escreve no banco compartilhado (lane x main) e a fila..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/db-write-gate.py\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "mcp__github__merge_pull_request|mcp__github__push_files|mcp__github__create_or_update_file|mcp__github__delete_file",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/db-write-gate.py\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "mcp__.*[Nn]ucleo-ia__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/db-write-gate.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "Elicitation": [
      {
        "matcher": "supabase",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/supabase-confirm-gate.py\"",
            "timeout": 15,
            "statusMessage": "Conferindo se a orquestradora pode responder a confirmacao do Supabase..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/ground-numbers.py",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/lane-registry.sh\" check \"$CLAUDE_PROJECT_DIR\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
