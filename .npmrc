legacy-peer-deps=true
# Quarentena de release (GP, 30/10/2026): o npm só resolve versão publicada há mais de 3 dias.
# Ela age quando o lock é GERADO (npm install/update). O npm ci NÃO a impõe: instala o que o lock
# já fixou, mesmo versão publicada hoje (medido com npm 11.19.1). O CI não barra versão fresca.
# Exceção para correção de segurança urgente: min-release-age-exclude[]=<pacote>, só com o OK da
# orquestradora, e registrada em tests/contracts/npm-quarentena-de-release.test.mjs.
min-release-age=3
