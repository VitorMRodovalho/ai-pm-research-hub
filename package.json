{
  "name": "ai-pm-hub-v2",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/verify-build-pages.mjs",
    "clean": "rm -rf dist",
    "build": "npm run clean && astro build && node scripts/patch-worker-polyfill.mjs",
    "preview": "astro preview",
    "smoke": "node scripts/smoke-test.mjs",
    "smoke:prod": "node scripts/smoke-test.mjs --base https://nucleoia.vitormr.dev",
    "astro": "astro",
    "test": "npm run test:structural && npm run test:behavioural",
    "test:structural": "node scripts/run-suite.mjs structural",
    "test:behavioural": "node scripts/run-suite.mjs behavioural",
    "test:ef": "node --experimental-strip-types --test tests/edge-functions/classify-badge.test.mjs tests/edge-functions/email-utils.test.mjs tests/edge-functions/webhook-parser.test.mjs tests/edge-functions/ef-contracts.test.mjs tests/edge-functions/ef-smoke.test.mjs",
    "test:contracts": "node scripts/run-suite.mjs contracts",
    "test:contracts:db": "node --test --test-concurrency=1 tests/contracts/schema-invariants.test.mjs tests/contracts/schema-cache-columns.test.mjs tests/contracts/log-retention.test.mjs tests/contracts/rpc-migration-coverage.test.mjs tests/contracts/1636-suite-nao-toca-candidatura-real.test.mjs",
    "test:browser:guards": "node tests/browser-guards.test.mjs",
    "smoke:routes": "node scripts/smoke-routes.mjs",
    "qa:kanban": "./scripts/qa_kanban_dark_release_gate.sh",
    "audit:dark:baseline": "./scripts/audit_dark_mode_visual_baseline.sh",
    "audit:dark:contrast": "./scripts/audit_dark_mode_contrast_snapshots.sh",
    "audit:permissions": "./scripts/audit_permissions_matrix_sync.sh",
    "lint:i18n": "eslint src/components/boards/**/*.tsx src/pages/admin/portfolio.astro",
    "lint:client-scripts": "eslint --no-config-lookup -c eslint.client-scripts.config.mjs \"src/**/*.astro\"",
    "test:visual:dark": "playwright test tests/visual/dark-mode.spec.ts --config=playwright.config.ts",
    "test:e2e": "playwright test tests/e2e/ --config=playwright.config.ts",
    "test:e2e:headed": "playwright test tests/e2e/ --config=playwright.config.ts --headed",
    "test:e2e:lifecycle": "playwright test tests/e2e/user-lifecycle.spec.ts --config=playwright.config.ts",
    "screenshots:multilang": "node scripts/screenshots-multilang.mjs",
    "screenshots:setup": "npx playwright install chromium",
    "db:types": "T=$(mktemp) && supabase gen types typescript --project-id ${SUPABASE_PROJECT_ID:-ldrfrvwhxsmgaabwmaik} > $T && head -1 $T | grep -q '^export type Json' && mv $T src/lib/database.gen.ts",
    "certs:backfill": "node --import ./scripts/lib/register-ts-resolve.mjs scripts/backfill-cert-pdfs.ts",
    "test:verdict": "node scripts/test-verdict.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.2.3",
    "@astrojs/react": "^6.0.2",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.3",
    "@cloudflare/puppeteer": "^1.1.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-visually-hidden": "^1.2.4",
    "@react-pdf/renderer": "^4.5.1",
    "@sentry/browser": "^10.47.0",
    "@supabase/supabase-js": "^2.105.4",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-table": "^8.21.3",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@turbodocx/html-to-docx": "^1.20.1",
    "astro": "~7.2.10",
    "chart.js": "^4.5.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.7.0",
    "marked": "^18.0.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.0",
    "ultrahtml": "1.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@typescript-eslint/parser": "^8.58.0",
    "astro-eslint-parser": "^3.1.0",
    "dotenv": "^17.4.0",
    "eslint": "^10.2.0",
    "eslint-plugin-astro": "^3.1.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.5.0",
    "playwright": "^1.59.1",
    "typescript": "^6.0.2",
    "wrangler": "^4.92.0"
  },
  "overrides": {
    "devalue": "^5.9.2",
    "esbuild": "^0.28.1",
    "undici": "^7.29.1",
    "sharp": "^0.35.4",
    "browserslist": "^4.28.7",
    "svgo": "^4.1.0",
    "fflate": "^0.8.3",
    "postcss-selector-parser": "^7.1.3",
    "js-yaml": "^4.3.2",
    "image-size": "^2.0.3",
    "ip-address": "^10.5.1"
  }
}
